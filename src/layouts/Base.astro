---
import '../styles/global.css';
import { nav, notice, studio, officialLinks, identity, quotes } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description: string;
  home?: boolean;
  preload?: { srcset: string; sizes: string };
}
const { title, description, home = true, preload } = Astro.props;
const fullTitle = title ? `${title} — Prof Harti | Concept de site` : `Prof Harti · أيوب حارتي — الفيزياء والكيمياء | Concept de site`;
// On the home page anchors are local; elsewhere they point back to the home page sections.
const anchor = (h: string) => (home ? h : withBase('') + h);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(withBase('og.png'), Astro.site).toString();
---
<!doctype html>
<html lang="ar" dir="rtl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#160a0d" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    {preload && <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_MA" />
    <meta property="og:locale:alternate" content="fr_MA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={`${description} — Concept non officiel proposé par Mansour Technologies.`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip" href="#main">انتقل إلى المحتوى <span lang="fr">· Aller au contenu</span></a>
    <div class="notice" role="note" lang="fr" dir="ltr">
      <div class="wrap notice__in">
        <span class="notice__dot" aria-hidden="true"></span>
        <p>{notice}</p>
      </div>
    </div>
    <header class="hdr" data-header>
      <div class="wrap hdr__in">
        <a class="brand" href={withBase('')} dir="ltr">
          <svg class="brand__bulb" viewBox="0 0 24 32" width="18" height="24" aria-hidden="true"><path d="M12 2a9 9 0 0 0-5.2 16.3c.9.7 1.4 1.6 1.4 2.7V23h7.6v-2c0-1.1.5-2 1.4-2.7A9 9 0 0 0 12 2Z" fill="#e9b949"/><path d="M8.6 25.5h6.8M9.6 28.5h4.8" stroke="#a88758" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span class="brand__word word">Prof <b>Harti</b></span><span class="sr-only"> — الصفحة الرئيسية</span>
        </a>
        <nav class="hdr__nav" aria-label="القائمة الرئيسية">
          <ul>
            {nav.map((n) => (
              <li><a href={anchor(n.href)}>{n.ar}</a></li>
            ))}
          </ul>
        </nav>
        <a class="hdr__cta" href={officialLinks.facebook.dm} target="_blank" rel="noopener noreferrer">راسل الأستاذ<span class="sr-only"> على فيسبوك ماسنجر (نافذة جديدة)</span></a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
          <span class="menu-btn__label">القائمة</span>
          <span class="menu-btn__bars" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="قائمة الموقع" hidden data-menu>
      <div class="menu__top wrap">
        <span class="brand__word word" dir="ltr">Prof <b>Harti</b></span>
        <button class="menu__close" type="button" data-menu-close aria-label="إغلاق القائمة">إغلاق <span aria-hidden="true">✕</span></button>
      </div>
      <nav class="wrap" aria-label="القائمة الكاملة">
        <ol class="menu__list">
          {nav.map((n) => (
            <li>
              <a href={anchor(n.href)} data-menu-link>
                <span class="menu__num">{n.num}</span>
                <span class="menu__label">{n.ar}</span>
                <span class="menu__fr fr" lang="fr">{n.fr}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="wrap menu__foot">
        <p class="menu__quote">{quotes.promise.ar}</p>
        <ul>
          {Object.values(officialLinks).map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener noreferrer" dir="ltr">{l.label} <span class="dim">{l.handle}</span><span class="sr-only"> (نافذة جديدة)</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap ftr__grid">
        <div class="ftr__brand">
          <p class="word ftr__word" dir="ltr"><span>Prof</span> <span class="y">Harti</span></p>
          <p class="ftr__ar">{identity.nameAr} — {identity.subjectAr}</p>
          <p class="ftr__small" lang="fr" dir="ltr">Ce site est une <strong>proposition de concept</strong>. Il n’est ni édité, ni validé, ni commandé par {identity.name}. Les informations et citations proviennent de ses canaux officiels publics (consultés le 26/11/2026).</p>
        </div>
        <nav aria-label="روابط أسفل الصفحة" class="ftr__nav">
          <ul>
            {nav.map((n) => <li><a href={anchor(n.href)}>{n.ar} <span class="dim fr" lang="fr">{n.fr}</span></a></li>)}
          </ul>
        </nav>
        <div class="ftr__nav">
          <ul>
            {Object.values(officialLinks).map((l) => (
              <li><a href={l.url} target="_blank" rel="noopener noreferrer" dir="ltr">{l.label} <span class="dim">{l.handle}</span><span class="sr-only"> (nouvel onglet)</span></a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="wrap ftr__base" lang="fr" dir="ltr">
        <p>{notice}</p>
        <p><a href={studio.url} target="_blank" rel="noopener">Concept digital proposé par Mansour Technologies.</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Notice: same field as the page, one step lighter, with his yellow as a single dot — visible but quiet */
  .notice { background: #24100f; color: #e6d9c6; font-size: 0.74rem; line-height: 1.4; position: relative; z-index: 31; border-bottom: 1px solid rgba(217, 191, 146, 0.22); }
  .notice__in { display: flex; gap: 0.6rem; align-items: center; padding-block: 0.42rem; }
  .notice p { margin: 0; font-weight: 600; letter-spacing: 0.01em; }
  .notice__dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); }

  .hdr { position: sticky; top: 0; z-index: 30; background: rgba(22, 10, 13, 0.88); backdrop-filter: saturate(140%) blur(12px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 1.25rem; height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--chalk); }
  .brand__word { font-size: 1.2rem; line-height: 1; font-weight: 800; white-space: nowrap; }
  @media (max-width: 359px) { .brand__word { font-size: 1.02rem; } .brand { gap: 0.35rem; } }
  .brand__word b { font-weight: 900; color: var(--gold); }
  .hdr__nav { margin-inline-start: auto; }
  .hdr__nav ul { display: flex; gap: clamp(1rem, 2vw, 2.2rem); list-style: none; margin: 0; padding: 0; }
  .hdr__nav a { text-decoration: none; font-size: 0.95rem; font-weight: 600; color: var(--dim); padding: 0.5rem 0; position: relative; transition: color 0.3s var(--ease); }
  .hdr__nav a::after { content: ''; position: absolute; inset-inline: 0; bottom: 0.15rem; height: 1px; background: var(--gold); transform: scaleX(0); transform-origin: right; transition: transform 0.4s var(--ease); }
  .hdr__nav a:hover, .hdr__nav a.is-active { color: var(--chalk); }
  .hdr__nav a:hover::after, .hdr__nav a.is-active::after { transform: scaleX(1); }
  .hdr__cta { display: inline-flex; align-items: center; min-height: 40px; padding: 0.3rem 1.1rem; border: 1px solid var(--gold); color: var(--gold); font-weight: 700; font-size: 0.92rem; text-decoration: none; border-radius: var(--radius); white-space: nowrap; transition: background 0.3s var(--ease), color 0.3s var(--ease); }
  .hdr__cta:hover { background: var(--gold); color: var(--ink); }
  .menu-btn { display: none; align-items: center; gap: 0.65rem; min-height: 44px; padding: 0.3rem 0.9rem; background: none; border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--chalk); font-weight: 700; font-size: 0.92rem; }
  .menu-btn__bars { display: grid; gap: 6px; width: 22px; }
  .menu-btn__bars i { display: block; height: 1.5px; background: currentColor; }
  .menu-btn__bars i:last-child { width: 60%; background: var(--gold); }
  @media (max-width: 1099px) { .hdr__nav { display: none; } .menu-btn { display: inline-flex; } .hdr__cta { margin-inline-start: auto; } }
  @media (max-width: 479px) { .hdr__cta { display: none; } .menu-btn { margin-inline-start: auto; } }

  .menu { position: fixed; inset: 0; z-index: 60; background: radial-gradient(90% 55% at 100% 0%, rgba(90, 26, 39, 0.6), transparent 70%), var(--ink); overflow-y: auto; display: flex; flex-direction: column; padding-bottom: 2rem; }
  .menu[hidden] { display: none; }
  .menu__top { display: flex; justify-content: space-between; align-items: center; min-height: var(--header-h); border-bottom: 1px solid var(--line); }
  .menu__close { background: none; border: 1px solid var(--line-strong); color: var(--chalk); min-height: 44px; padding: 0.3rem 1rem; border-radius: var(--radius); font-weight: 700; }
  .menu__list { list-style: none; margin: 0; padding: 1rem 0; }
  .menu__list a { display: grid; grid-template-columns: 2.4rem 1fr; align-items: baseline; column-gap: 0.6rem; padding: 0.7rem 0; text-decoration: none; border-bottom: 1px solid var(--line); }
  .menu__num { font-family: var(--f-word); font-weight: 600; letter-spacing: 0.12em; color: var(--gold); font-size: 0.75rem; grid-row: span 2; }
  .menu__label { font-weight: 700; font-size: clamp(1.9rem, 8vw, 3.4rem); line-height: 1.3; transition: color 0.3s var(--ease); }
  .menu__fr { font-family: var(--f-word); font-size: 0.66rem; color: var(--dim); letter-spacing: 0.16em; text-transform: uppercase; justify-self: start; }
  .menu__list a:hover .menu__label { color: var(--gold); }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu__list li { animation: menuIn 0.6s var(--ease) both; }
    .menu__list li:nth-child(2) { animation-delay: 40ms; } .menu__list li:nth-child(3) { animation-delay: 80ms; } .menu__list li:nth-child(4) { animation-delay: 120ms; }
    .menu__list li:nth-child(5) { animation-delay: 160ms; } .menu__list li:nth-child(6) { animation-delay: 200ms; }
    @keyframes menuIn { from { opacity: 0; transform: translateX(-14px); } to { opacity: 1; transform: none; } }
  }
  .menu__foot { margin-top: auto; padding-top: 1.5rem; }
  .menu__quote { color: var(--gold); font-weight: 600; font-size: 1.1rem; }
  .menu__foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1.5rem; }
  .menu__foot a { text-decoration: none; font-weight: 600; display: inline-block; padding: 0.4rem 0; }

  .ftr { border-top: 1px solid var(--line); padding-top: clamp(3.5rem, 7vw, 6rem); background: var(--ink); }
  .ftr__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 860px) { .ftr__grid { grid-template-columns: 1.6fr 1fr 1fr; } }
  .ftr__word { font-size: clamp(2.8rem, 7vw, 5rem); margin: 0 0 0.8rem; text-align: end; }
  .ftr__word .y { color: var(--gold); }
  .ftr__ar { color: var(--gold); margin: 0 0 1rem; font-size: 1.05rem; font-weight: 600; }
  .ftr__small { font-size: var(--fs-small); max-width: 52ch; color: var(--dim); text-align: left; }
  .ftr__nav ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
  .ftr__nav a { text-decoration: none; color: var(--chalk); display: inline-block; padding: 0.35rem 0; font-weight: 600; transition: color 0.3s var(--ease); }
  .ftr__nav a:hover { color: var(--gold); }
  .ftr__nav .dim { font-weight: 500; font-size: 0.78rem; }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.5rem 2rem; margin-top: 3rem; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--dim); }
  .ftr__base p { margin: 0; }
  .ftr__base a { color: var(--chalk); }
  main:focus { outline: none; }
</style>

<script>
  import { initMenu, initScrollSpy } from '../scripts/menu';
  import { initReveal } from '../scripts/reveal';
  import { initFacades } from '../scripts/embeds';
  initMenu();
  initScrollSpy();
  initReveal();
  initFacades();
</script>

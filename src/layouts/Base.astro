---
import '../styles/global.css';
import { nav, notice, studio, officialLinks, identity } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  current?: string; // nav href key
}
const { title, description, current = '' } = Astro.props;
const fullTitle = current === '' ? `Prof Harti — Physique-Chimie | Concept de site` : `${title} — Prof Harti | Concept de site`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(withBase('og.png'), Astro.site).toString();
const isCurrent = (href: string) => href === current;
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0e0b0a" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={`${description} — Concept non officiel proposé par Mansour Technologies.`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <div class="notice" role="note">
      <div class="wrap notice__in">
        <span class="notice__dot" aria-hidden="true"></span>
        <p>{notice}</p>
      </div>
    </div>
    <header class="hdr" data-header>
      <div class="wrap hdr__in">
        <a class="brand" href={withBase('')}>
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 28 28" width="28" height="28"><circle cx="14" cy="14" r="13" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5"/><ellipse cx="14" cy="14" rx="13" ry="5" fill="none" stroke="currentColor" stroke-width="1.5" transform="rotate(-30 14 14)"/><circle cx="14" cy="14" r="3.2" fill="#f7c51e"/></svg>
          </span>
          <span class="brand__word">Prof <b>Harti</b></span><span class="sr-only"> — accueil</span>
        </a>
        <nav class="hdr__nav" aria-label="Navigation principale">
          <ul>
            {nav.slice(1).map((n) => (
              <li><a href={withBase(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.short ?? n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
          <span class="menu-btn__label">Menu</span>
          <span class="menu-btn__bars" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu du site" hidden data-menu>
      <div class="menu__top wrap">
        <span class="kicker">Index — {nav.length} chapitres</span>
        <button class="menu__close" type="button" data-menu-close aria-label="Fermer le menu">Fermer <span aria-hidden="true">✕</span></button>
      </div>
      <nav class="wrap" aria-label="Menu complet">
        <ol class="menu__list">
          {nav.map((n) => (
            <li>
              <a href={withBase(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>
                <span class="menu__num mono">{n.num}</span>
                <span class="menu__label">{n.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="wrap menu__foot">
        <span class="kicker">Canaux officiels</span>
        <ul>
          {Object.values(officialLinks).map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} <span class="muted">{l.handle}</span><span class="sr-only"> (nouvel onglet)</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap ftr__grid">
        <div class="ftr__brand">
          <p class="display ftr__word">Prof <span class="hl">Harti</span></p>
          <p class="ar ftr__ar" lang="ar" dir="rtl">{identity.subjectAr} — {identity.nameAr}</p>
          <p class="muted ftr__small">Ce site est une <strong>proposition de concept</strong>. Il n’est ni édité, ni validé, ni commandé par {identity.name}. Les contenus pédagogiques interactifs sont des démonstrations originales.</p>
        </div>
        <nav aria-label="Pied de page" class="ftr__nav">
          <span class="kicker">Pages</span>
          <ul>
            {nav.map((n) => <li><a href={withBase(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="ftr__nav">
          <span class="kicker">Canaux officiels</span>
          <ul>
            {Object.values(officialLinks).map((l) => (
              <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}<span class="sr-only"> (nouvel onglet)</span></a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="wrap ftr__base">
        <p>{notice}</p>
        <p><a href={studio.url} target="_blank" rel="noopener">Concept digital proposé par Mansour Technologies.</a></p>
      </div>
    </footer>
    <div id="live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>

<style is:global>
  .notice { background: var(--signal); color: var(--ink); font-size: 0.78rem; line-height: 1.35; position: relative; z-index: 31; }
  .notice__in { display: flex; gap: 0.6rem; align-items: center; padding-block: 0.4rem; }
  .notice p { margin: 0; font-weight: 600; font-stretch: 90%; }
  .notice__dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--bordeaux); }

  .hdr { position: sticky; top: 0; z-index: 30; background: rgba(14, 11, 10, 0.92); backdrop-filter: saturate(140%) blur(8px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--chalk); }
  .brand__word { font-family: var(--f-display); font-stretch: 70%; font-weight: 600; font-size: 1.45rem; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1; }
  .brand__word b { font-weight: 900; color: var(--signal); font-style: italic; }
  .hdr__nav ul { display: flex; gap: clamp(0.6rem, 1.6vw, 1.6rem); list-style: none; margin: 0; padding: 0; }
  .hdr__nav a { text-decoration: none; font-size: 0.9rem; font-weight: 560; font-stretch: 88%; color: var(--chalk-dim); padding: 0.5rem 0; position: relative; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--chalk); }
  .hdr__nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--signal); }
  .menu-btn { display: none; align-items: center; gap: 0.7rem; min-height: 44px; padding: 0.4rem 0.2rem 0.4rem 0.9rem; background: none; border: 1px solid var(--line-strong); border-radius: var(--radius); color: var(--chalk); font-family: var(--f-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .menu-btn__bars { display: grid; gap: 5px; width: 34px; padding-inline-end: 0.7rem; }
  .menu-btn__bars i { display: block; height: 2px; background: currentColor; }
  .menu-btn__bars i:last-child { width: 60%; background: var(--signal); }
  @media (max-width: 1099px) { .hdr__nav { display: none; } .menu-btn { display: inline-flex; } }

  .menu { position: fixed; inset: 0; z-index: 60; background: var(--ink); overflow-y: auto; display: flex; flex-direction: column; padding-bottom: 2rem; }
  .menu[hidden] { display: none; }
  .menu__top { display: flex; justify-content: space-between; align-items: center; min-height: var(--header-h); border-bottom: 1px solid var(--line); }
  .menu__close { background: none; border: 1px solid var(--line-strong); color: var(--chalk); min-height: 44px; padding: 0.4rem 0.9rem; border-radius: var(--radius); font-family: var(--f-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .menu__list { list-style: none; margin: 0; padding: 1rem 0; }
  .menu__list a { display: flex; align-items: baseline; gap: 1rem; padding: 0.55rem 0; text-decoration: none; border-bottom: 1px solid var(--line); }
  .menu__num { color: var(--signal); font-size: 0.8rem; min-width: 2ch; }
  .menu__label { font-family: var(--f-display); font-stretch: 66%; font-weight: 820; text-transform: uppercase; font-size: clamp(2rem, 9vw, 4.2rem); line-height: 1; }
  .menu__list a:hover .menu__label, .menu__list a[aria-current='page'] .menu__label { color: var(--signal); }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) .menu__list li { animation: menuIn 0.5s var(--ease) both; }
    .menu__list li:nth-child(2) { animation-delay: 30ms; } .menu__list li:nth-child(3) { animation-delay: 60ms; } .menu__list li:nth-child(4) { animation-delay: 90ms; }
    .menu__list li:nth-child(5) { animation-delay: 120ms; } .menu__list li:nth-child(6) { animation-delay: 150ms; } .menu__list li:nth-child(7) { animation-delay: 180ms; } .menu__list li:nth-child(8) { animation-delay: 210ms; }
    @keyframes menuIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  }
  .menu__foot { margin-top: auto; padding-top: 1.5rem; display: grid; gap: 0.6rem; }
  .menu__foot ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .menu__foot a { text-decoration: none; font-weight: 650; display: inline-block; padding: 0.35rem 0; }

  .ftr { border-top: 1px solid var(--line); padding-top: clamp(3rem, 6vw, 5rem); background: var(--ink); }
  .ftr__grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .ftr__grid { grid-template-columns: 1.6fr 1fr 1fr; } }
  .ftr__word { font-size: clamp(3rem, 8vw, 5.5rem); margin: 0 0 0.4rem; }
  .ftr__ar { color: var(--gold); margin: 0 0 1rem; font-size: 1.05rem; }
  .ftr__small { font-size: var(--fs-small); max-width: 46ch; }
  .ftr__nav ul { list-style: none; padding: 0; margin: 0.8rem 0 0; display: grid; gap: 0.15rem; }
  .ftr__nav a { text-decoration: none; color: var(--chalk-dim); display: inline-block; padding: 0.3rem 0; }
  .ftr__nav a:hover { color: var(--signal); }
  .ftr__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.5rem 2rem; margin-top: 3rem; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--chalk-dim); }
  .ftr__base p { margin: 0; }
  .ftr__base a { color: var(--chalk); }
  main:focus { outline: none; }
</style>

<script>
  import { initMenu } from '../scripts/menu';
  import { initReveal } from '../scripts/reveal';
  initMenu();
  initReveal();
</script>

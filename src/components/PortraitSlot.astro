---
/**
 * Premium placeholder for the official portrait. Public photos are not licensed for reuse,
 * so this slot is designed to receive a portrait supplied by the teacher on approval.
 */
interface Props { class?: string; caption?: boolean }
const { class: cls = '', caption = true } = Astro.props;
---
<figure class={`portrait ${cls}`}>
  <svg class="portrait__art" viewBox="0 0 300 380" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="pg" x1="0" y1="0" x2="0.4" y2="1"><stop offset="0" stop-color="#7d2235" /><stop offset="1" stop-color="#3a0e18" /></linearGradient>
      <pattern id="pp" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M22 0H0V22" fill="none" stroke="rgba(237,230,218,.06)" stroke-width="1" /></pattern>
    </defs>
    <rect width="300" height="380" fill="url(#pg)" />
    <rect width="300" height="380" fill="url(#pp)" />
    <g fill="none" stroke="rgba(237,230,218,.5)" stroke-width="1.3">
      <circle cx="150" cy="140" r="52" stroke-dasharray="3 6" />
      <path d="M58 380 C 64 268, 112 232, 150 232 S 236 268, 242 380" stroke-dasharray="3 6" />
    </g>
    <text x="22" y="356" fill="#f7c51e" font-family="Archivo Variable, sans-serif" font-weight="900" font-size="64" style="font-stretch:65%" letter-spacing="-1">AH</text>
  </svg>
  {caption && <figcaption class="portrait__cap mono">Portrait officiel<br />à fournir sur validation</figcaption>}
</figure>
<style>
  .portrait { margin: 0; position: relative; overflow: hidden; background: var(--bordeaux); }
  .portrait__art { width: 100%; height: 100%; }
  .portrait__cap { position: absolute; top: 0.75rem; left: 0.75rem; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--chalk); background: rgba(14, 11, 10, 0.55); padding: 0.35rem 0.5rem; line-height: 1.35; }
</style>

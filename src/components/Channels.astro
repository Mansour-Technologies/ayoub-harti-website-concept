---
import { officialLinks } from '../data/site';
const lines = [
  { ...officialLinks.instagram, note: 'Compte vérifié. Reels de cours, résumés et annonces du programme.' },
  { ...officialLinks.youtube, note: 'Chaîne officielle, présentation de l’Offre Excellence.' },
  { ...officialLinks.facebook, note: 'Page officielle liée depuis la chaîne YouTube.' },
];
---
<section class="section channels" aria-labelledby="ch-title">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-num">Suivre Prof Harti</span>
      <h2 id="ch-title">Là où il enseigne déjà.</h2>
      <p class="muted">Seuls les canaux officiels vérifiés sont liés. Aucun chiffre d’audience n’est repris ici.</p>
    </header>
    <ul class="ch">
      {lines.map((l) => (
        <li>
          <a href={l.url} target="_blank" rel="noopener noreferrer">
            <span class="ch__name display">{l.label}</span>
            <span class="ch__handle mono">{l.handle}</span>
            <span class="ch__note">{l.note}</span>
            <span class="ch__go" aria-hidden="true">↗</span>
            <span class="sr-only">(ouvre un nouvel onglet)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .ch { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .ch a { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'name go' 'handle go' 'note note'; gap: 0.15rem 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line-strong); text-decoration: none; transition: color 0.2s; }
  @media (min-width: 900px) { .ch a { grid-template-columns: minmax(16rem, 0.8fr) 12rem 1fr auto; grid-template-areas: 'name handle note go'; align-items: center; } }
  .ch__name { grid-area: name; font-size: clamp(2.4rem, 6vw, 4.8rem); transition: color 0.2s; }
  .ch__handle { grid-area: handle; color: var(--signal); font-size: 0.85rem; }
  .ch__note { grid-area: note; color: var(--chalk-dim); }
  .ch__go { grid-area: go; font-size: 2rem; color: var(--chalk-dim); transition: transform 0.3s var(--ease), color 0.2s; }
  .ch a:hover .ch__name { color: var(--signal); }
  .ch a:hover .ch__go { transform: translate(4px, -4px); color: var(--signal); }
</style>

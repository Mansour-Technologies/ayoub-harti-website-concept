---
/** Original chapter glyphs — one visual signature per unit. Decorative (aria-hidden). */
interface Props { kind: string; size?: number; class?: string }
const { kind, size = 64, class: cls = '' } = Astro.props;
const k = kind.toLowerCase();
const names = ['wave','nucleus','circuit','flask','parabola','field','spark'];
const type = names.includes(k) ? k : k.includes('onde') ? 'wave' : k.includes('nucl') ? 'nucleus' : k.includes('élec') || k.includes('elec') ? 'circuit' : k.includes('chim') ? 'flask' : k.includes('magn') ? 'field' : k.includes('program') ? 'spark' : 'parabola';
---
<svg class={`glyph ${cls}`} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
  {type === 'wave' && (<>
    <path d="M4 32 C 10 14, 16 14, 22 32 S 34 50, 40 32 S 52 14, 60 32" />
    <path d="M4 46 H60" opacity=".35" stroke-dasharray="2 5" />
    <circle cx="22" cy="32" r="3" fill="var(--signal)" stroke="none" />
  </>)}
  {type === 'nucleus' && (<>
    <circle cx="28" cy="30" r="5" /><circle cx="36" cy="30" r="5" fill="var(--signal)" stroke="none" /><circle cx="32" cy="37" r="5" />
    <path d="M44 20 L56 8" /><path d="M50 8 H56 V14" /><path d="M14 48 l-6 6" opacity=".5" /><path d="M46 44 l8 8" opacity=".5" />
  </>)}
  {type === 'circuit' && (<>
    <path d="M6 32 H18 L21 24 L26 40 L31 24 L36 40 L39 32 H44" /><path d="M44 22 V42" /><path d="M50 22 V42" stroke="var(--signal)" /><path d="M50 32 H58" />
  </>)}
  {type === 'flask' && (<>
    <path d="M25 8 H39" /><path d="M28 8 V24 L14 52 a4 4 0 0 0 3.6 5.6 H46.4 A4 4 0 0 0 50 52 L36 24 V8" />
    <path d="M19 44 H45" stroke="var(--signal)" /><circle cx="30" cy="50" r="2" /><circle cx="37" cy="47" r="1.5" />
  </>)}
  {type === 'parabola' && (<>
    <path d="M6 54 Q 32 -8 58 54" /><path d="M6 54 H60" opacity=".35" />
    <path d="M6 54 L20 34" stroke="var(--signal)" /><path d="M14 32 L20 34 L19 40" stroke="var(--signal)" />
    <circle cx="32" cy="23" r="3" fill="currentColor" stroke="none" />
  </>)}
  {type === 'field' && (<>
    <circle cx="32" cy="32" r="6" /><circle cx="32" cy="32" r="14" opacity=".6" /><circle cx="32" cy="32" r="24" opacity=".3" /><circle cx="32" cy="32" r="2" fill="var(--signal)" stroke="none" />
  </>)}
  {type === 'spark' && (<>
    <path d="M32 6 V18 M32 46 V58 M6 32 H18 M46 32 H58 M14 14 l8 8 M42 42 l8 8 M50 14 l-8 8 M22 42 l-8 8" /><circle cx="32" cy="32" r="7" fill="var(--signal)" stroke="none" />
  </>)}
</svg>

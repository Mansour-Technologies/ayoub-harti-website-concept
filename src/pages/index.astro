---
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import { quotes, levels, programme, inPerson, formats, officialVideo, reels, officialLinks, contact, whatsappHref } from '../data/site';

const wa = contact.whatsapp ? whatsappHref(contact.whatsapp) : null;
const primaryHref = wa ?? officialLinks.facebook.dm;
const primaryVia = wa ? 'واتساب' : 'فيسبوك ماسنجر';
const chapters = ['Les Ondes', 'الموجات', 'Nucléaire', 'النووي', 'Dipôle RC', 'RL', 'RLC', 'La pile', 'العمود', 'Mécanique', 'الميكانيك', 'Chimie', 'الكيمياء'];
const posterOnError = `if(!this.dataset.f){this.dataset.f='1';this.removeAttribute('srcset');this.src='${officialVideo.posterFallback}'}else{this.closest('[data-poster]').classList.add('is-fallback')}`;
---
<Base preload={{ srcset: officialVideo.posterSrcset, sizes: officialVideo.posterSizes }} description="Prof Harti (أيوب حارتي) — الفيزياء والكيمياء، من الأولى إعدادي حتى الثانية باك. « ما تخافش من الفيزياء ». Concept de site vitrine.">

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <span class="hero__streak hero__streak--a" aria-hidden="true"></span>
    <span class="hero__streak hero__streak--b" aria-hidden="true"></span>
    <div class="hero__grid">
      <figure class="hero__media" id="hero-video">
        <div class="poster" data-embed="yt" data-id={officialVideo.id} data-title={`Vidéo officielle YouTube — ${officialVideo.titleAr}`} data-poster>
          <div class="poster__frame" data-embed-slot>
            <button class="poster__btn" type="button" data-embed-play>
              <span class="sr-only" lang="fr">Lire la vidéo officielle : {officialVideo.titleAr}</span>
              <span class="poster__duo" aria-hidden="true">
                <img src={officialVideo.poster} srcset={officialVideo.posterSrcset} sizes={officialVideo.posterSizes} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" onerror={posterOnError} />
              </span>
              <span class="poster__fallback" aria-hidden="true">
                <span class="word" dir="ltr">PROF<br /><b>HARTI</b></span>
                <span class="poster__fallback-ar">{officialVideo.titleAr}</span>
              </span>
              <span class="poster__play" aria-hidden="true">
                <span class="poster__disc"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                <span class="poster__playtxt"><b>{officialVideo.titleAr}</b><span class="ltr">YouTube · {officialVideo.duration}</span></span>
              </span>
            </button>
          </div>
        </div>
        <figcaption class="credit" lang="fr" dir="ltr">Image : vidéo officielle YouTube — Prof Harti</figcaption>
      </figure>

      <div class="hero__text">
        <p class="hero__sig hand" dir="ltr" aria-hidden="true">Prof Harti</p>
        <h1 class="hero__word" id="hero-title">
          <span class="word" dir="ltr" aria-hidden="true"><span class="hero__prof">Prof</span><span class="hero__harti">Harti</span></span>
          <span class="sr-only">Prof Harti — أيوب حارتي، أستاذ الفيزياء والكيمياء</span>
        </h1>
        <blockquote class="hero__tag" data-reveal>
          <p>مع <b>أيوب حارتي</b>… <mark>ما تخافش من الفيزياء</mark></p>
          <footer lang="fr" dir="ltr">« {quotes.banner.fr} » — {quotes.banner.src}</footer>
        </blockquote>
        <div class="hero__chips" data-reveal>
          <span class="pill" dir="ltr"><span class="pill__on">Physique</span><span>Chimie</span></span>
          <span class="chips" dir="ltr"><span>3<sup>ème</sup></span><span class="on">2 BAC</span><span>1 BAC</span></span>
        </div>
        <div class="hero__ctas" data-reveal>
          <a class="btn" href={primaryHref} target="_blank" rel="noopener noreferrer">
            راسل الأستاذ <span class="arrow" aria-hidden="true">←</span>
            <span class="sr-only">على {primaryVia} (نافذة جديدة)</span>
          </a>
          <a class="btn btn--ghost" href="#offre">عرض التفوق</a>
        </div>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true">
    <div class="band__in" dir="ltr">
      {[0, 1].map(() => (
        <span class="band__set">{chapters.map((c) => <span class={/[\u0600-\u06FF]/.test(c) ? 'band__item band__item--ar' : 'band__item'}>{c}<i>✦</i></span>)}</span>
      ))}
    </div>
  </div>

  <!-- ============ 01 LE PROF ============ -->
  <section class="prof" id="prof" aria-labelledby="prof-title">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow__num">01</span><span class="eyebrow__rule"></span>الأستاذ <span class="fr" lang="fr">Le prof</span></p>
      <h2 class="prof__quote" id="prof-title" data-reveal>
        <span class="q" aria-hidden="true">«</span>أنا هنا باش نساعدك و<mark>نبسط</mark> ليك الفيزياء<span class="q" aria-hidden="true">»</span>
      </h2>
      <p class="gloss" lang="fr" dir="ltr" data-reveal>« {quotes.bio.fr} » <span class="src">{quotes.bio.src}</span></p>

      <div class="facts">
        <article class="fact" data-reveal>
          <p class="fact__big word" dir="ltr">2017</p>
          <div>
            <h3 class="fact__title">التعليم عن بعد</h3>
            <blockquote class="fact__quote"><p>«{quotes.since2017.ar}»</p></blockquote>
            <p class="fact__fr" lang="fr" dir="ltr">« {quotes.since2017.fr} » <span class="src">{quotes.since2017.src}</span></p>
          </div>
        </article>
        <article class="fact" data-reveal>
          <p class="fact__big word" dir="ltr">1AC→2BAC</p>
          <div>
            <h3 class="fact__title">من الإعدادي حتى الباك</h3>
            <ul class="levels">
              {levels.map((l) => <li><span class="levels__ar">{l.ar}</span><span class="levels__fr ltr" lang="fr">{l.short}</span></li>)}
            </ul>
            <p class="fact__fr" lang="fr" dir="ltr">Physique et chimie, du collège au 2ème Bac. <span class="src">Description de la chaîne YouTube officielle</span></p>
          </div>
        </article>
        <article class="fact" data-reveal>
          <p class="fact__big word" dir="ltr">Casa</p>
          <div>
            <h3 class="fact__title">حتى حضوري، ف{inPerson.areaAr}</h3>
            <blockquote class="fact__quote"><p>«{quotes.exercises.ar}»</p></blockquote>
            <p class="fact__fr" lang="fr" dir="ltr">Cours en présentiel annoncés à {inPerson.place} — {inPerson.area}, {inPerson.daysFr.toLowerCase()} à {inPerson.time}. <span class="src">Annonce Instagram du {inPerson.announced} — à confirmer avec le prof.</span></p>
          </div>
        </article>
      </div>

      <p class="signoff" data-reveal>
        <span class="ruqaa signoff__ar">{quotes.signOff.ar}</span>
        <span class="src" lang="fr" dir="ltr">{quotes.signOff.src}</span>
      </p>
    </div>
  </section>

  <!-- ============ 02 AU TABLEAU ============ -->
  <section class="sbora" id="sbora" aria-labelledby="sbora-title">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow__num">02</span><span class="eyebrow__rule"></span>السبورة <span class="fr" lang="fr">Au tableau</span></p>
      <div class="sbora__head">
        <h2 class="h2" id="sbora-title" data-reveal>كل درس… <mark>بالألوان</mark></h2>
        <p class="gloss" lang="fr" dir="ltr" data-reveal>Ses tableaux et ses fiches « ملخصات » ont un code : formules en français, annotations en arabe, une couleur par chapitre, « عرض التفوق » écrit en haut de chaque tableau. <span class="src">Titre proposé pour ce concept — pas une citation.</span></p>
      </div>
      <div class="sbora__board" data-reveal>
        <Board />
        <p class="src" lang="fr" dir="ltr">Planche originale réalisée pour ce concept, dans l’esprit de ses fiches publiques. Ses vraies fiches la remplaceront sur validation.</p>
      </div>

      <div class="reels">
        <p class="reels__intro" data-reveal>شوفو فالسبورة <span class="dim fr" lang="fr">· deux reels officiels, chargés seulement si vous cliquez</span></p>
        <div class="reels__row">
          {reels.map((r, i) => (
            <div class="reel" data-embed="ig" data-id={r.code} data-title={`Reel Instagram officiel @prof_harti — ${r.title}`} data-reveal>
              <div class="reel__frame" data-embed-slot>
                <button class="reel__btn" type="button" data-embed-play>
                  <span class="reel__num word" dir="ltr" aria-hidden="true">0{i + 1}</span>
                  <span class="reel__board" aria-hidden="true">
                    <span class="ruqaa">عرض التفوق</span>
                    <span class="hand" dir="ltr">{r.chapter}</span>
                  </span>
                  <span class="reel__title">{r.titleAr}</span>
                  <span class="reel__fr" lang="fr" dir="ltr">{r.title}</span>
                  <span class="reel__cta"><span class="poster__disc" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span><span lang="fr" dir="ltr">Charger le reel Instagram officiel</span></span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 LIVES DE NUIT ============ -->
  <section class="lives" id="lives" aria-labelledby="lives-title">
    <div class="wrap lives__grid">
      <div class="lives__clock" aria-hidden="true">
        <span class="lives__on"><i></i>LIVE</span>
        <span class="word lives__time" dir="ltr">23<span class="lives__colon">:</span>00</span>
      </div>
      <div>
        <p class="eyebrow"><span class="eyebrow__num">03</span><span class="eyebrow__rule"></span>لايفات الليل <span class="fr" lang="fr">Les lives de nuit</span></p>
        <h2 class="h2" id="lives-title" data-reveal>القراية مع الحارتي <mark>ما كتسالاش</mark> مع الجرس</h2>
        <p class="gloss" lang="fr" dir="ltr" data-reveal>Ses formats reconnaissables, observés sur ses comptes officiels. Archives 2023–2026, pas un programme actuel. <span class="src">Titre proposé pour ce concept — pas une citation.</span></p>
        <ol class="sched">
          {formats.map((f) => (
            <li data-reveal>
              <span class="sched__time word" dir="ltr">{f.time}</span>
              <span class="sched__ar">{f.ar}</span>
              <span class="sched__fr" lang="fr" dir="ltr">{f.fr} <span class="src">{f.note}</span></span>
            </li>
          ))}
        </ol>
        <p class="lives__joke" data-reveal>«غادي تسحر و تنعس» <span class="src" lang="fr" dir="ltr">Son annonce du live marathon de chimie, 23:00 → 03:00 (YouTube)</span></p>
      </div>
    </div>
  </section>

  <!-- ============ 04 OFFRE ============ -->
  <section class="offre" id="offre" aria-labelledby="offre-title">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow__num">04</span><span class="eyebrow__rule"></span>البرنامج <span class="fr" lang="fr">Offre Excellence · à distance</span></p>
      <h2 class="offre__title" id="offre-title" data-reveal>{programme.nameAr}</h2>
      <p class="offre__open" data-reveal><mark>{programme.open.ar}</mark> <span class="src" lang="fr" dir="ltr">« {programme.open.fr} » — {programme.open.src}</span></p>
      <ol class="offre__list">
        {programme.includes.map((it, i) => (
          <li data-reveal>
            <span class="offre__n" aria-hidden="true">{['①', '②', '③'][i]}</span>
            <span class="offre__ar">{it.ar}</span>
            <span class="offre__fr" lang="fr" dir="ltr">{it.fr}</span>
          </li>
        ))}
      </ol>
      <div class="offre__foot" data-reveal>
        <p class="offre__step"><span class="dim">{quotes.stepByStep.ar}</span><span class="src" lang="fr" dir="ltr">« {quotes.stepByStep.fr} » — {quotes.stepByStep.src}</span></p>
        <div class="offre__ctas">
          <a class="btn btn--dark" href={primaryHref} target="_blank" rel="noopener noreferrer">صيفط كلمة «عرض» <span class="arrow" aria-hidden="true">←</span><span class="sr-only">على {primaryVia} (نافذة جديدة)</span></a>
          <a class="btn btn--line" href="#hero-video">▶ فيديو العرض <span class="ltr">0:59</span></a>
        </div>
        <p class="offre__note" lang="fr" dir="ltr">Tarifs et dates non publiés : ils sont communiqués directement par le prof.</p>
      </div>
    </div>
  </section>

  <!-- ============ 05 INSCRIPTION ============ -->
  <section class="ins" id="inscription" aria-labelledby="ins-title">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow__num">05</span><span class="eyebrow__rule"></span>التسجيل <span class="fr" lang="fr">Comment s’inscrire</span></p>
      <h2 class="h2" id="ins-title" data-reveal>ثلاث خطوات، <mark>دقة دقة</mark></h2>
      <ol class="steps">
        <li data-reveal>
          <span class="steps__n">①</span>
          <h3>صيفط كلمة <mark>«عرض»</mark></h3>
          <p lang="fr" dir="ltr">C’est la consigne qu’il publie : un message avec le mot « عرض ». {wa ? 'Sur WhatsApp.' : 'Ici, par message sur sa page Facebook (WhatsApp sur validation du prof).'}</p>
        </li>
        <li data-reveal>
          <span class="steps__n">②</span>
          <h3>كتوصلك التفاصيل</h3>
          <p lang="fr" dir="ltr">Niveau, programme, modalités : le prof répond directement. Aucun paiement ni formulaire sur ce site.</p>
        </li>
        <li data-reveal>
          <span class="steps__n">③</span>
          <h3>كتقرا معاه حتى تفهم</h3>
          <p lang="fr" dir="ltr">À distance avec « عرض التفوق », ou en présentiel à {inPerson.area} ({inPerson.daysFr.toLowerCase()}, {inPerson.time}, selon son annonce du {inPerson.announced}).</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ 06 CONTACT ============ -->
  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow__num">06</span><span class="eyebrow__rule"></span>تواصل <span class="fr" lang="fr">Contact</span></p>
      <h2 class="contact__title" id="contact-title" data-reveal>سول و انا غادي <mark>نجاوبك</mark></h2>
      <p class="gloss" lang="fr" dir="ltr" data-reveal>« Pose ta question, je te réponds. » <span class="src">La formule de ses reels questions-réponses (Instagram)</span></p>
      <div class="cwall">
        {wa && (
          <a class="cbtn cbtn--primary" data-whatsapp href={wa} target="_blank" rel="noopener noreferrer">
            <span class="cbtn__k" lang="fr" dir="ltr">WhatsApp · message « عرض »</span>
            <span class="cbtn__v">صيفط «عرض» فواتساب</span>
            <span class="arrow" aria-hidden="true">←</span>
          </a>
        )}
        <a class={wa ? 'cbtn' : 'cbtn cbtn--primary'} href={officialLinks.facebook.dm} target="_blank" rel="noopener noreferrer">
          <span class="cbtn__k" dir="ltr">Facebook · Messenger · {officialLinks.facebook.handle}</span>
          <span class="cbtn__v">راسلو فالفيسبوك</span>
          <span class="arrow" aria-hidden="true">←</span><span class="sr-only">(نافذة جديدة)</span>
        </a>
        <a class="cbtn cbtn--strong" href={officialLinks.youtube.url} target="_blank" rel="noopener noreferrer">
          <span class="cbtn__k" dir="ltr">YouTube · {officialLinks.youtube.handle}</span>
          <span class="cbtn__v">القناة</span>
          <span class="arrow" aria-hidden="true">←</span><span class="sr-only">(نافذة جديدة)</span>
        </a>
        <a class="cbtn" href={officialLinks.facebook.url} target="_blank" rel="noopener noreferrer">
          <span class="cbtn__k" dir="ltr">Facebook · {officialLinks.facebook.handle}</span>
          <span class="cbtn__v">الصفحة</span>
          <span class="arrow" aria-hidden="true">←</span><span class="sr-only">(نافذة جديدة)</span>
        </a>
      </div>
      <p class="also">
        <span class="dim">كذلك على</span>
        <a href={officialLinks.instagram.url} target="_blank" rel="noopener noreferrer" dir="ltr">Instagram {officialLinks.instagram.handle}<span class="sr-only"> (نافذة جديدة)</span></a>
      </p>
      <p class="signoff signoff--end" data-reveal><span class="ruqaa signoff__ar">{quotes.signOff.ar}</span></p>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; overflow: hidden; background: radial-gradient(80% 60% at 50% 30%, rgba(217, 164, 65, 0.22), transparent 70%), var(--ink); padding-bottom: clamp(2.5rem, 6vw, 4rem); }
  .hero__streak { position: absolute; width: 46vw; height: 2px; background: linear-gradient(90deg, transparent, var(--gold), transparent); opacity: 0.55; pointer-events: none; z-index: 2; }
  .hero__streak--a { top: 14%; left: -12vw; transform: rotate(-38deg); }
  .hero__streak--b { top: 22%; right: -14vw; transform: rotate(38deg); }
  .hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .hero__media { margin: 0; position: relative; }
  .poster__frame { position: relative; height: clamp(430px, 64svh, 640px); background: var(--ink-2); overflow: hidden; }
  .poster__btn { all: unset; position: absolute; inset: 0; display: block; cursor: pointer; }
  .poster__btn:focus-visible { outline: 3px solid var(--signal); outline-offset: -6px; }
  .poster__duo { position: absolute; inset: -1px; overflow: hidden; background: linear-gradient(180deg, #ffe066 0%, #f7c51e 50%, #e3a90f 70%, #8e2238 90%, #3c0c17 100%); isolation: isolate; }
  .poster__duo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; mix-blend-mode: luminosity; filter: contrast(1.12) brightness(0.84); transform: scale(1.32); transform-origin: 50% 14%; }
  .poster__duo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 46%, rgba(10, 8, 7, 0.55) 62%, rgba(10, 8, 7, 0.97) 72%, var(--ink) 78%); }
  @media (prefers-reduced-motion: no-preference) {
    .poster__duo img { animation: push 9s var(--ease) both; }
    @keyframes push { from { transform: scale(1.42); } to { transform: scale(1.32); } }
  }
  .poster__fallback { display: none; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(247, 197, 30, 0.06) 0 2px, transparent 2px 18px), linear-gradient(180deg, var(--bordeaux), var(--bordeaux-2)); place-content: center; text-align: center; gap: 1rem; }
  .poster__fallback .word { font-size: clamp(4rem, 20vw, 9rem); color: var(--chalk); }
  .poster__fallback .word b { color: var(--signal); }
  .poster__fallback-ar { font-weight: 900; color: var(--gold); font-size: 1.2rem; }
  :global(.is-fallback) .poster__fallback { display: grid; }
  :global(.is-fallback) .poster__duo { display: none; }
  .poster__play { position: absolute; top: 1rem; inset-inline-start: 1rem; display: flex; align-items: center; gap: 0.7rem; padding: 0.4rem 1rem 0.4rem 0.4rem; background: rgba(10, 8, 7, 0.82); border-radius: 999px; color: var(--chalk); backdrop-filter: blur(6px); transition: transform 0.3s var(--ease), background 0.3s; }
  .poster__disc { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--signal); color: var(--ink); flex: none; }
  .poster__playtxt { display: grid; line-height: 1.25; }
  .poster__playtxt b { font-size: 0.95rem; font-weight: 900; }
  .poster__playtxt .ltr { font-size: 0.72rem; color: var(--dim); letter-spacing: 0.04em; }
  .poster__btn:hover .poster__play { transform: scale(1.04); background: rgba(10, 8, 7, 0.95); }
  @media (prefers-reduced-motion: no-preference) {
    .poster__disc { animation: pulse 2.6s ease-out infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(247, 197, 30, 0.6); } 70%, 100% { box-shadow: 0 0 0 14px rgba(247, 197, 30, 0); } }
  }
  .poster.is-loaded .poster__frame { height: auto; aspect-ratio: 16 / 9; }
  .hero:has(.is-loaded) .hero__text { margin-top: 0.4em; }
  .poster__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .credit { position: absolute; top: 1rem; left: 0.35rem; z-index: 3; font-size: 0.66rem; color: rgba(10, 8, 7, 0.78); writing-mode: vertical-rl; transform: rotate(180deg); font-weight: 600; letter-spacing: 0.03em; }
  .poster.is-loaded + .credit { position: static; padding: 0.4rem var(--gutter); writing-mode: horizontal-tb; transform: none; color: var(--dim); }
  :global(.is-fallback) + .credit { color: var(--dim); }

  .hero__text { position: relative; z-index: 4; padding-inline: var(--gutter); margin-top: -0.62em; font-size: clamp(4.2rem, 24vw, 9rem); }
  .hero__sig { position: absolute; top: -0.78em; left: calc(var(--gutter) + 0.2rem); margin: 0; font-size: 2.1rem; color: var(--gold); transform: rotate(-8deg); line-height: 1; z-index: 2; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }
  .hero__word { margin: 0; font-size: 1em; }
  .hero__word .word { display: block; text-align: left; line-height: 0.82; }
  .hero__prof { display: block; font-size: 0.5em; color: var(--chalk); text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5); }
  .hero__harti { display: block; color: transparent; background: linear-gradient(180deg, #ffe27a 0%, #f7c51e 45%, #d9a441 100%); -webkit-background-clip: text; background-clip: text; filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.55)); padding-inline-end: 0.06em; }
  .hero__tag { margin: 1.1rem 0 0; font-size: 1rem; }
  .hero__tag p { margin: 0; font-size: clamp(1.45rem, 6.4vw, 2.3rem); line-height: 1.45; font-weight: 800; }
  .hero__tag b { color: var(--gold); font-weight: 900; }
  .hero__tag mark { background: none; color: var(--chalk); font-weight: 1000; box-shadow: inset 0 -0.38em 0 rgba(200, 16, 46, 0.85); }
  .hero__tag footer { font-size: var(--fs-micro); color: var(--dim); margin-top: 0.4rem; text-align: right; }

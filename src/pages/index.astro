---
import Base from '../layouts/Base.astro';
import VideoFacade from '../components/VideoFacade.astro';
import Glyph from '../components/Glyph.astro';
import PortraitSlot from '../components/PortraitSlot.astro';
import { identity, levels, programme, officialVideo, officialLinks, contact } from '../data/site';

const collegeLv = levels.filter((l) => l.cycle === 'Collège');
const lyceeLv = levels.filter((l) => l.cycle === 'Lycée');
const wa = contact.whatsapp ? `https://wa.me/${contact.whatsapp.replace(/\D/g, '')}` : null;
const ext = { target: '_blank', rel: 'noopener noreferrer' } as const;
---
<Base title="Accueil" description="Prof Ayoub Harti — professeur de physique-chimie, du collège à la 2ème Bac. Son approche, les niveaux, l’Offre Excellence (عرض التفوق) et ses canaux officiels.">
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid wrap">
      <div class="hero__text">
        <p class="kicker hero__kicker"><span class="hl" aria-hidden="true">●</span> Prof {identity.name} · {identity.subject} · Collège → 2ème Bac</p>
        <h1 class="display hero__title" id="hero-title">
          <span class="hero__l1">La physique,</span>
          <span class="hero__l2">sans <span class="hero__peur"><span>peur.</span></span></span>
        </h1>
        <p class="ar hero__ar" lang="ar" dir="rtl">نفهمو الفيزياء خطوة بخطوة</p>
        <p class="lead hero__lead">Ayoub Harti enseigne la physique et la chimie aux élèves marocains, du collège au baccalauréat, avec une promesse simple : des cours simplifiés et une explication claire.</p>
        <div class="hero__cta">
          <a class="btn" href={officialLinks.instagram.dm} {...ext}>Écrire au prof <span class="arr" aria-hidden="true">→</span><span class="sr-only"> (Instagram, nouvel onglet)</span></a>
          <a class="btn ghost" href="#offre">Découvrir <span class="ar" lang="ar">عرض التفوق</span></a>
        </div>
        <p class="hero__fine mono">Accroche originale proposée pour ce concept — pas une citation du professeur.</p>
      </div>

      <div class="hero__stage">
        <div class="stage">
          <span class="stage__word display" aria-hidden="true">HARTI</span>
          <svg class="stage__orbits" viewBox="0 0 400 400" aria-hidden="true">
            <ellipse cx="200" cy="200" rx="185" ry="70" transform="rotate(-28 200 200)" />
            <ellipse cx="200" cy="200" rx="185" ry="70" transform="rotate(32 200 200)" />
            <circle class="stage__e" r="6"><animateMotion dur="9s" repeatCount="indefinite" path="M15,200 a185,70 0 1,0 370,0 a185,70 0 1,0 -370,0" /></circle>
          </svg>
          <PortraitSlot class="stage__portrait" />
          <div class="idcard">
            <p class="idcard__ar ar" lang="ar" dir="rtl">{identity.nameAr}</p>
            <p class="idcard__name display">Prof Harti</p>
            <p class="idcard__meta mono"><span>Physique</span><span aria-hidden="true">·</span><span>Chimie</span></p>
            <a class="idcard__handle mono" href={officialLinks.instagram.url} {...ext}>{officialLinks.instagram.handle}<span class="sr-only"> sur Instagram (nouvel onglet)</span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="band" aria-hidden="true">
      <div class="band__in">
        {[0, 1].map(() => (
          <span class="band__seq">
            <span>Physique</span><i>✦</i><span>Chimie</span><i>✦</i><span class="ar">الفيزياء والكيمياء</span><i>✦</i><span>1AC → 2BAC</span><i>✦</i><span class="ar">ما تخافش</span><i>✦</i>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 PROFESSEUR -->
  <section class="section prof" id="professeur" aria-labelledby="prof-title">
    <div class="wrap">
      <div class="prof__head" data-reveal>
        <span class="sec-num">01 — Le professeur</span>
        <h2 class="display prof__title" id="prof-title">Simplifier.<br /><span class="hl">Expliquer.</span><br />Accompagner.</h2>
      </div>
      <div class="prof__grid">
        <blockquote class="quote" data-reveal>
          <p class="quote__ar ar" lang="ar" dir="rtl">دروس مبسطة و شرح واضح</p>
          <p class="quote__fr">« Des cours simplifiés et une explication claire. »</p>
          <footer class="mono">— Bannière de la chaîne YouTube officielle</footer>
        </blockquote>
        <blockquote class="quote" data-reveal>
          <p class="quote__ar ar" lang="ar" dir="rtl">أنا هنا باش نساعدك ونبسط ليك الفيزياء</p>
          <p class="quote__fr">« Je suis là pour t’aider et te simplifier la physique. »</p>
          <footer class="mono">— Bio du compte Instagram @prof_harti</footer>
        </blockquote>
      </div>
      <ol class="principles">
        <li data-reveal>
          <Glyph kind="spark" size={48} />
          <h3>Le cours, rendu simple</h3>
          <p>Le point de départ est l’élève qui a peur de la matière. Chaque notion est reformulée jusqu’à devenir évidente.</p>
        </li>
        <li data-reveal>
          <Glyph kind="wave" size={48} />
          <h3>En darija, avec les mots du Bac</h3>
          <p>Il explique en darija et en arabe, en gardant les notations et le vocabulaire scientifiques attendus à l’examen.</p>
        </li>
        <li data-reveal>
          <Glyph kind="parabola" size={48} />
          <h3><span class="ar" lang="ar">دقة دقة</span> — pas à pas</h3>
          <p>Sa présentation du programme promet d’avancer avec l’élève « étape par étape, jusqu’à comprendre toutes les leçons ».</p>
        </li>
      </ol>
      <p class="src-note mono">Citations et formulations : canaux officiels du professeur, consultés le 26/11/2026. Traductions proposées pour ce concept.</p>
    </div>
  </section>

  <!-- 02 NIVEAUX -->
  <section class="section paper levels" id="niveaux" aria-labelledby="lv-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <span class="sec-num">02 — Matières & niveaux</span>
        <h2 id="lv-title">Du collège au Bac.</h2>
        <p class="muted">Physique et chimie, pour les six niveaux annoncés sur sa chaîne officielle.</p>
      </header>
      <div class="subjects" data-reveal>
        <div class="subject"><Glyph kind="parabola" size={56} /><span class="display">Physique</span><span class="ar" lang="ar">الفيزياء</span></div>
        <div class="subject"><Glyph kind="flask" size={56} /><span class="display">Chimie</span><span class="ar" lang="ar">الكيمياء</span></div>
      </div>
      <div class="cycles">
        {[{ name: 'Collège', ar: 'الإعدادي', list: collegeLv }, { name: 'Lycée', ar: 'الثانوي التأهيلي', list: lyceeLv }].map((c) => (
          <div class="cycle" data-reveal>
            <h3 class="cycle__h"><span>{c.name}</span><span class="ar" lang="ar">{c.ar}</span></h3>
            <ul class="lv">
              {c.list.map((l) => (
                <li>
                  <span class="lv__code display">{l.short}</span>
                  <span class="lv__label">{l.label}</span>
                  <span class="lv__ar ar" lang="ar" dir="rtl">{l.ar}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 OFFRE -->
  <section class="section offer" id="offre" aria-labelledby="offer-title">
    <div class="wrap offer__grid">
      <div data-reveal>
        <span class="sec-num">03 — Le programme</span>
        <h2 class="offer__title" id="offer-title">
          <span class="offer__ar ar" lang="ar" dir="rtl">{programme.nameAr}</span>
          <span class="offer__fr display">{programme.nameFr}</span>
        </h2>
        <p class="lead">Le programme de physique présenté par le professeur sur sa chaîne officielle. Voici ce qu’il annonce :</p>
      </div>
      <div class="offer__panel" data-reveal>
        <ol class="incl">
          {programme.includes.map((it, i) => (
            <li>
              <span class="incl__n display">0{i + 1}</span>
              <span class="incl__fr">{it.fr}</span>
              <span class="incl__ar ar" lang="ar" dir="rtl">{it.ar}</span>
            </li>
          ))}
        </ol>
        <p class="offer__note">Tarifs, dates et modalités ne sont pas publiés : le professeur les communique directement.</p>
        <div class="offer__cta">
          <a class="btn" href={officialLinks.instagram.dm} {...ext}>Demander les détails <span class="arr" aria-hidden="true">→</span><span class="sr-only"> (Instagram, nouvel onglet)</span></a>
          <a class="btn ghost" href="#video">Voir la présentation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 VIDEO -->
  <section class="section video" id="video" aria-labelledby="video-title">
    <div class="wrap">
      <header class="video__head" data-reveal>
        <span class="sec-num">04 — En vidéo</span>
        <h2 class="display video__title" id="video-title">Il le dit <span class="hl">mieux que nous.</span></h2>
      </header>
      <figure class="video__fig" data-reveal>
        <div class="video__frame">
          <VideoFacade id={officialVideo.id} title={`${officialVideo.titleAr} — Prof Harti`} hd />
        </div>
        <figcaption class="video__cap">
          <span class="ar" lang="ar" dir="rtl">{officialVideo.titleAr}</span>
          <span>{officialVideo.title} · {officialVideo.duration}</span>
          <span class="mono muted">Chaîne officielle {officialLinks.youtube.handle} · le lecteur YouTube se charge uniquement au clic</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- CHAINES -->
  <section class="section channels" id="chaines" aria-labelledby="ch-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <span class="sec-num">Où le suivre</span>
        <h2 id="ch-title">Là où il enseigne déjà.</h2>
      </header>
      <ul class="ch">
        {[
          { ...officialLinks.instagram, note: 'Compte vérifié : reels de cours, résumés, annonces du programme.' },
          { ...officialLinks.youtube, note: 'Chaîne officielle et présentation de l’Offre Excellence.' },
          { ...officialLinks.facebook, note: 'Page officielle, liée depuis sa chaîne YouTube.' },
        ].map((l) => (
          <li data-reveal>
            <a href={l.url} {...ext}>
              <span class="ch__name display">{l.label}</span>
              <span class="ch__handle mono">{l.handle}</span>
              <span class="ch__note">{l.note}</span>
              <span class="ch__go" aria-hidden="true">↗</span>
              <span class="sr-only">(nouvel onglet)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 INSCRIPTION -->
  <section class="section paper steps-sec" id="inscription" aria-labelledby="ins-title">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <span class="sec-num">05 — Comment s’inscrire</span>
        <h2 id="ins-title">Trois étapes. <span class="steps-sec__hl">Zéro stress.</span></h2>
        <p class="muted">Parcours basé sur les annonces publiques du professeur : l’inscription se fait par message, directement avec lui.</p>
      </header>
      <ol class="steps">
        <li data-reveal>
          <span class="steps__n display">1</span>
          <h3>Envoie-lui un message</h3>
          <p>En message privé sur Instagram. Dans sa présentation, il demande simplement un message contenant le mot <span class="ar" lang="ar">« عرض »</span>.</p>
        </li>
        <li data-reveal>
          <span class="steps__n display">2</span>
          <h3>Reçois les détails</h3>
          <p>Indique ton niveau. Contenu, organisation et tarif te sont communiqués directement par le professeur.</p>
        </li>
        <li data-reveal>
          <span class="steps__n display">3</span>
          <h3>Avance étape par étape</h3>
          <p>Cours expliqués paragraphe par paragraphe, exercices variés, méthode pour les examens nationaux.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 06 CONTACT -->
  <section class="section contact" id="contact" aria-labelledby="ct-title">
    <div class="wrap">
      <header class="contact__head" data-reveal>
        <span class="sec-num">06 — Contact</span>
        <h2 class="display contact__title" id="ct-title">Une question ?<br /><span class="hl">Écris-lui.</span></h2>
        <p class="ar contact__ar" lang="ar" dir="rtl">تواصل مع الأستاذ مباشرة</p>
      </header>
      <div class="cbtns" data-reveal>
        <a class="cbtn cbtn--primary" href={officialLinks.instagram.dm} {...ext}>
          <span class="cbtn__k mono">Message privé · recommandé</span>
          <span class="cbtn__l display">Instagram</span>
          <span class="cbtn__h mono">{officialLinks.instagram.handle}</span>
          <span class="cbtn__go" aria-hidden="true">→</span>
          <span class="sr-only">(nouvel onglet)</span>
        </a>
        {wa && (
          <a class="cbtn" href={wa} {...ext} data-whatsapp>
            <span class="cbtn__k mono">Message</span>
            <span class="cbtn__l display">WhatsApp</span>
            <span class="cbtn__go" aria-hidden="true">→</span>
            <span class="sr-only">(nouvel onglet)</span>
          </a>
        )}
        <a class="cbtn" href={officialLinks.youtube.url} {...ext}>
          <span class="cbtn__k mono">Vidéos</span>
          <span class="cbtn__l display">YouTube</span>
          <span class="cbtn__h mono">{officialLinks.youtube.handle}</span>
          <span class="cbtn__go" aria-hidden="true">↗</span>
          <span class="sr-only">(nouvel onglet)</span>
        </a>
        <a class="cbtn" href={officialLinks.facebook.url} {...ext}>
          <span class="cbtn__k mono">Page</span>
          <span class="cbtn__l display">Facebook</span>
          <span class="cbtn__h mono">{officialLinks.facebook.handle}</span>
          <span class="cbtn__go" aria-hidden="true">↗</span>
          <span class="sr-only">(nouvel onglet)</span>
        </a>
      </div>
      <p class="contact__note muted">Ce site est un concept non officiel : il ne collecte aucune donnée et ne transmet aucun message. Tous les boutons ouvrent les canaux officiels du professeur.</p>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 70% at 78% 35%, rgba(107, 26, 43, 0.6), transparent 70%), radial-gradient(30% 40% at 82% 18%, rgba(247, 197, 30, 0.09), transparent 70%); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: 2.5rem; padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem); }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1.15fr 0.85fr; align-items: center; gap: 3rem; } }
  .hero__kicker { margin-bottom: 1.2rem; }
  .hero__title { font-size: min(14.6vw, 6.5rem); margin: 0; }
  @media (min-width: 1000px) { .hero__title { font-size: min(7.4vw, 7.6rem); } .hero__l1 { white-space: nowrap; } }
  .hero__l1, .hero__l2 { display: block; }
  .hero__l2 { margin-top: 0.04em; }
  .hero__peur { position: relative; display: inline-block; transform: rotate(-1.6deg); color: var(--ink); padding: 0 0.08em; }
  .hero__peur::before { content: ''; position: absolute; inset: 0; background: var(--signal); z-index: 0; transform-origin: left; }
  .hero__peur span { position: relative; z-index: 1; }
  .hero__ar { font-size: clamp(1.15rem, 2.2vw, 1.6rem); color: var(--gold); margin: 1.2rem 0 1rem; font-weight: 600; }
  .hero__lead { color: var(--chalk-dim); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__cta .ar { font-size: 1rem; text-transform: none; }
  .hero__fine { font-size: 0.68rem; color: #8f8578; margin-top: 1.25rem; letter-spacing: 0.04em; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__l1, .hero__l2, .hero__ar, .hero__lead, .hero__cta { animation: rise 0.9s var(--ease) both; }
    .hero__l2 { animation-delay: 0.08s; } .hero__ar { animation-delay: 0.2s; } .hero__lead { animation-delay: 0.28s; } .hero__cta { animation-delay: 0.36s; }
    .hero__peur::before { animation: sweep 0.7s var(--ease) 0.55s both; }
    .stage { animation: rise 1.1s var(--ease) 0.15s both; }
    @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @keyframes sweep { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }

  .stage { position: relative; aspect-ratio: 4 / 4.7; max-width: 520px; margin-inline: auto; width: 100%; }
  .stage__word { position: absolute; right: -0.06em; top: -0.05em; font-size: clamp(6rem, 22vw, 12rem); writing-mode: vertical-rl; color: transparent; -webkit-text-stroke: 1.5px rgba(237, 230, 218, 0.18); line-height: 0.8; pointer-events: none; }
  .stage__orbits { position: absolute; left: -6%; top: -4%; width: 92%; fill: none; stroke: rgba(200, 160, 99, 0.45); stroke-width: 1.2; z-index: 1; pointer-events: none; }
  .stage__e { fill: var(--signal); }
  @media (prefers-reduced-motion: reduce) { .stage__e { display: none; } }
  :global(.stage__portrait) { position: absolute; left: 0; top: 0; width: 82%; height: 90%; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.9); }
  .idcard { position: absolute; right: 0; bottom: 0; z-index: 2; width: min(62%, 300px); background: var(--ink); border: 1px solid var(--line-strong); border-top: 4px solid var(--signal); padding: 1rem 1.1rem 1.1rem; display: grid; gap: 0.2rem; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.85); }
  .idcard__ar { margin: 0; color: var(--gold); font-size: 1.15rem; font-weight: 700; line-height: 1.5; }
  .idcard__name { margin: 0; font-size: clamp(2rem, 5vw, 2.8rem); }
  .idcard__meta { margin: 0.2rem 0 0; display: flex; gap: 0.5rem; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--chalk-dim); }
  .idcard__handle { justify-self: start; margin-top: 0.4rem; color: var(--signal); font-size: 0.85rem; text-decoration: none; padding: 0.3rem 0; border-bottom: 1px solid currentColor; }

  .band { position: relative; border-top: 1px solid var(--line); background: var(--signal); color: var(--ink); overflow: hidden; }
  .band__in { display: flex; width: max-content; padding-block: 0.8rem; }
  .band__seq { display: flex; align-items: center; gap: 1.4rem; padding-inline-end: 1.4rem; font-family: var(--f-display); font-stretch: 70%; font-weight: 850; text-transform: uppercase; font-size: clamp(1.2rem, 2.4vw, 1.8rem); white-space: nowrap; line-height: 1; }
  .band__seq .ar { font-family: var(--f-ar); font-weight: 700; font-size: 0.85em; }
  .band__seq i { font-style: normal; color: var(--bordeaux); font-size: 0.7em; }
  @media (prefers-reduced-motion: no-preference) { .band__in { animation: marquee 38s linear infinite; } @keyframes marquee { to { transform: translateX(-50%); } } }

  /* PROF */
  .prof__title { font-size: var(--fs-h1); margin: 1rem 0 3rem; }
  .prof__grid { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .prof__grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .quote { margin: 0; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line-strong); background: linear-gradient(160deg, var(--ink-2), var(--ink)); position: relative; }
  .quote::before { content: '«'; position: absolute; top: -0.2em; left: 0.3em; font-family: var(--f-display); font-size: 5rem; color: var(--signal); line-height: 1; }
  .quote__ar { padding-top: 1.2rem; font-size: clamp(1.6rem, 3.4vw, 2.5rem); font-weight: 700; color: var(--chalk); margin: 0.5rem 0 0.75rem; line-height: 1.5; }
  .quote__fr { font-size: var(--fs-lead); color: var(--signal); margin: 0 0 1rem; }
  .quote footer { font-size: 0.72rem; letter-spacing: 0.06em; color: var(--chalk-dim); }
  .principles { list-style: none; padding: 0; margin: clamp(3rem, 6vw, 4.5rem) 0 0; display: grid; gap: 0; border-top: 1px solid var(--line-strong); }
  @media (min-width: 900px) { .principles { grid-template-columns: repeat(3, 1fr); } }
  .principles li { padding: 1.75rem 0; border-bottom: 1px solid var(--line-strong); display: grid; gap: 0.6rem; align-content: start; }
  @media (min-width: 900px) { .principles li { padding: 2rem 2rem 2rem 0; border-bottom: 0; } .principles li + li { padding-inline-start: 2rem; border-inline-start: 1px solid var(--line-strong); } }
  .principles :global(.glyph) { color: var(--signal); }
  .principles h3 { font-size: var(--fs-h3); font-stretch: 82%; text-transform: uppercase; }
  .principles h3 .ar { text-transform: none; color: var(--gold); }
  .principles p { color: var(--chalk-dim); margin: 0; }
  .src-note { font-size: 0.7rem; color: #8f8578; margin-top: 2rem; letter-spacing: 0.04em; }

  /* LEVELS */
  .subjects { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1px; background: var(--paper-ink); border: 1px solid var(--paper-ink); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .subject { background: var(--paper); display: grid; justify-items: start; gap: 0.3rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .subject :global(.glyph) { color: var(--bordeaux); }
  .subject .display { font-size: clamp(1.7rem, 8.5vw, 4.5rem); }
  .subject .ar { color: var(--bordeaux); font-size: 1.1rem; }
  .cycles { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .cycles { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .cycle__h { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.8rem; font-family: var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper-muted); font-weight: 500; padding-bottom: 0.8rem; border-bottom: 2px solid var(--paper-ink); }
  .cycle__h .ar { letter-spacing: 0; text-transform: none; font-size: 1rem; color: var(--bordeaux); }
  .lv { list-style: none; padding: 0; margin: 0; }
  .lv li { display: grid; grid-template-columns: 6.5rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 0.25rem; border-bottom: 1px solid rgba(26, 20, 18, 0.18); transition: background 0.25s, padding 0.3s var(--ease); }
  .lv li:hover { background: var(--paper-ink); color: var(--paper); padding-inline: 1rem; }
  .lv li:hover .lv__code { color: var(--signal); }

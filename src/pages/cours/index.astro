---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Glyph from '../../components/Glyph.astro';
import { levels, chapters } from '../../data/courses';
import { videos } from '../../data/videos';
import { withBase } from '../../lib/url';

const videoFor = (chapterId: string) => videos.find((v) => v.chapter === chapterId);
---
<Base title="Cours et programmes" description="Les chapitres de physique-chimie du collège à la 2ème Bac, filtrables par niveau, domaine et mot-clé." current="cours/">
  <PageHero num="02" kicker="Cours & programmes" title="Chaque chapitre, <em>à sa place.</em>" ar="كل درس فبلاصتو" glyph="flask">
    <p>{chapters.length} chapitres organisés par niveau et par unité. L’idée physique d’abord, la formule clé ensuite. Marque les chapitres étudiés : ta progression apparaît dans l’Espace étudiant.</p>
  </PageHero>

  <section class="section courses" data-courses>
    <div class="wrap">
      <div class="filters" role="search" aria-label="Filtrer les chapitres">
        <div class="filters__row">
          <span class="kicker" id="lv-label">Niveau</span>
          <div class="seg" role="group" aria-labelledby="lv-label" data-filter="level">
            <button type="button" aria-pressed="true" data-value="all">Tous</button>
            {levels.map((l) => <button type="button" aria-pressed="false" data-value={l.id}>{l.label}</button>)}
          </div>
        </div>
        <div class="filters__row">
          <span class="kicker" id="dm-label">Domaine</span>
          <div class="seg" role="group" aria-labelledby="dm-label" data-filter="domain">
            <button type="button" aria-pressed="true" data-value="all">Tout</button>
            <button type="button" aria-pressed="false" data-value="physique">Physique</button>
            <button type="button" aria-pressed="false" data-value="chimie">Chimie</button>
          </div>
        </div>
        <div class="field filters__search">
          <label for="course-q">Rechercher un chapitre</label>
          <input class="input" id="course-q" type="search" placeholder="ex. ondes, RC, pH, Newton…" autocomplete="off" data-search />
        </div>
      </div>
      <p class="count mono" data-count aria-live="polite">{chapters.length} chapitres affichés</p>

      <ol class="chap" data-list>
        {chapters.map((c) => {
          const lv = levels.find((l) => l.id === c.level)!;
          const v = videoFor(c.id);
          return (
            <li class="chap__item" data-level={c.level} data-domain={c.domain} data-text={`${c.title} ${c.unit} ${c.idea} ${c.formula ?? ''} ${lv.label}`.toLowerCase()} data-id={c.id}>
              <Glyph kind={c.domain === 'chimie' ? 'flask' : c.unit} size={44} class="chap__glyph" />
              <div class="chap__main">
                <p class="chap__meta mono"><span>{lv.label}</span> · <span>{c.unit}</span></p>
                <h2 class="chap__title">{c.title}</h2>
                <p class="chap__ar ar" lang="ar" dir="rtl">{c.titleAr}</p>
                <p class="chap__idea">{c.idea}</p>
              </div>
              <div class="chap__side">
                {c.formula && <p class="chap__formula mono">{c.formula}</p>}
                <div class="chap__actions">
                  <button type="button" class="btn ghost small" aria-pressed="false" data-study={c.id}><span data-study-label>Marquer étudié</span><span class="sr-only"> : {c.title}</span></button>
                  {v && <a class="link-arrow" href={withBase(`videotheque/?v=${v.id}`)}>Leçon vidéo<span class="sr-only"> : {c.title}</span> →</a>}
                </div>
              </div>
            </li>
          );
        })}
      </ol>
      <div class="empty" data-empty hidden>
        <p class="display">Aucun chapitre.</p>
        <p class="muted">Essaie un autre mot-clé ou réinitialise les filtres.</p>
        <button type="button" class="btn small" data-clear>Réinitialiser les filtres</button>
      </div>
      <p class="demo-note muted">Liste de démonstration établie d’après le programme marocain public ; contenus pédagogiques originaux à remplacer par ceux du professeur.</p>
    </div>
  </section>
</Base>

<style>
  .filters { display: grid; gap: 1.1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line-strong); }
  @media (min-width: 1100px) { .filters { grid-template-columns: auto auto 1fr; align-items: end; gap: 2rem; } }
  .filters__row { display: grid; gap: 0.4rem; }
  .filters .seg { width: auto; }
  .count { font-size: 0.78rem; color: var(--chalk-dim); margin: 1rem 0; letter-spacing: 0.06em; }
  .chap { list-style: none; padding: 0; margin: 0; }
  .chap__item { display: grid; grid-template-columns: 44px 1fr; gap: 0.5rem 1.25rem; padding: 1.6rem 0; border-bottom: 1px solid var(--line); }
  .chap__item[hidden] { display: none; }
  @media (min-width: 900px) { .chap__item { grid-template-columns: 56px 1fr 18rem; align-items: start; } }
  :global(.chap__glyph) { color: var(--chalk-dim); margin-top: 0.3rem; }
  .chap__meta { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--signal); margin: 0 0 0.35rem; }
  .chap__title { font-size: clamp(1.35rem, 2.4vw, 1.9rem); font-stretch: 80%; font-weight: 800; text-transform: uppercase; }
  .chap__ar { color: var(--gold); margin: 0.2rem 0 0.4rem; font-size: 1rem; }
  .chap__idea { color: var(--chalk-dim); margin: 0; max-width: 60ch; }
  .chap__side { grid-column: 2; display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .chap__side { grid-column: 3; justify-items: start; } }
  .chap__formula { margin: 0; font-size: 1rem; padding: 0.45rem 0.7rem; background: var(--ink-2); border-inline-start: 3px solid var(--signal); }
  .chap__actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: center; }
  .chap__item.is-done .chap__title::after { content: ' ✓'; color: var(--ok); }
  .empty { padding: 3rem 0; text-align: start; }
  .empty .display { font-size: var(--fs-h2); margin: 0 0 0.5rem; }
  .demo-note { font-size: var(--fs-small); margin-top: 2rem; }
</style>

<script>
  import { read, toggleIn, announce } from '../../lib/store';
  const root = document.querySelector<HTMLElement>('[data-courses]')!;
  const items = Array.from(root.querySelectorAll<HTMLElement>('.chap__item'));
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const state = { level: 'all', domain: 'all', q: '' };
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function setSeg(name: 'level' | 'domain', value: string) {
    const group = root.querySelector<HTMLElement>(`[data-filter="${name}"]`)!;
    if (!group.querySelector(`[data-value="${value}"]`)) value = 'all';
    state[name] = value;
    group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === value)));
  }
  function apply() {
    const q = norm(state.q.trim());
    let n = 0;
    items.forEach((it) => {
      const ok = (state.level === 'all' || it.dataset.level === state.level) && (state.domain === 'all' || it.dataset.domain === state.domain) && (!q || norm(it.dataset.text || '').includes(q));
      it.hidden = !ok;
      if (ok) n++;
    });
    count.textContent = `${n} chapitre${n > 1 ? 's' : ''} affiché${n > 1 ? 's' : ''}`;
    empty.hidden = n > 0;
    const url = new URL(location.href);
    if (state.level === 'all') url.searchParams.delete('niveau'); else url.searchParams.set('niveau', state.level);
    history.replaceState(null, '', url);
  }
  root.querySelectorAll<HTMLElement>('[data-filter]').forEach((g) =>
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      setSeg(g.dataset.filter as 'level' | 'domain', b.dataset.value || 'all');
      apply();
    }),
  );
  search.addEventListener('input', () => { state.q = search.value; apply(); });
  root.querySelector('[data-clear]')?.addEventListener('click', () => { setSeg('level', 'all'); setSeg('domain', 'all'); search.value = ''; state.q = ''; apply(); search.focus(); });

  function paintStudy() {
    const done = new Set(read('courses'));
    items.forEach((it) => {
      const on = done.has(it.dataset.id || '');
      it.classList.toggle('is-done', on);
      const b = it.querySelector<HTMLButtonElement>('[data-study]')!;
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('[data-study-label]')!.textContent = on ? 'Étudié ✓' : 'Marquer étudié';
    });
  }
  root.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-study]');
    if (!b) return;
    const on = toggleIn('courses', b.dataset.study!);
    paintStudy();
    announce(on ? 'Chapitre marqué comme étudié.' : 'Chapitre retiré des chapitres étudiés.');
  });

  const p = new URLSearchParams(location.search).get('niveau');
  if (p) setSeg('level', p);
  paintStudy();
  apply();
</script>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Glyph from '../../components/Glyph.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import { videos } from '../../data/videos';
import { levels } from '../../data/courses';

const levelLabel = (id: string) => (id === 'all' ? 'Tous niveaux' : levels.find((l) => l.id === id)?.label ?? id);
const units = Array.from(new Set(videos.map((v) => v.unit)));
const payload = videos.map((v) => ({ ...v, levelLabel: levelLabel(v.level) }));
---
<Base title="Vidéothèque" description="Vidéothèque par chapitre : vidéo officielle intégrée, leçons organisées, recherche, filtres par niveau, favoris et reprise de lecture (démonstration)." current="videotheque/">
  <PageHero num="03" kicker="Vidéothèque" title="Regarder. <em>Reprendre.</em> Retenir." ar="الفيديوهات مرتبة حسب الدروس" glyph="wave">
    <p>Une bibliothèque organisée par chapitre, avec recherche, filtres, favoris et reprise. La vidéo officielle provient de la chaîne @ProfHarti ; les autres emplacements accueilleront ses leçons après validation.</p>
  </PageHero>

  <section class="section vt" data-vt>
    <script type="application/json" id="vt-data" set:html={JSON.stringify(payload)} />
    <div class="wrap">
      <div class="vt__stage" data-stage aria-live="polite">
        <!-- filled by script; server fallback below -->
        <div class="st">
          <div class="st__media"><VideoFacade id="bQRpHAGhIXw" title={videos[0].titleAr ?? videos[0].title} eager /></div>
          <div class="st__info">
            <p class="st__meta mono">Tous niveaux · Programme · 0:59</p>
            <h2 class="st__title">{videos[0].title}</h2>
            <p class="st__sum">{videos[0].summary}</p>
          </div>
        </div>
      </div>

      <div class="vt__rel" data-related-wrap hidden>
        <h2 class="kicker">Leçons liées</h2>
        <ul class="rel" data-related></ul>
      </div>

      <div class="vt__resume" data-resume-wrap hidden>
        <h2 class="vt__h">Reprendre où tu t’es arrêté</h2>
        <ul class="resume" data-resume></ul>
      </div>

      <div class="vt__tools" role="search" aria-label="Rechercher dans la vidéothèque">
        <div class="field vt__search">
          <label for="vt-q">Rechercher une leçon</label>
          <input id="vt-q" class="input" type="search" placeholder="ex. demi-vie, diffraction, RC…" autocomplete="off" data-q />
        </div>
        <div class="filters__row">
          <span class="kicker" id="vt-lv">Niveau</span>
          <div class="seg" role="group" aria-labelledby="vt-lv" data-lv>
            <button type="button" aria-pressed="true" data-value="all">Tous</button>
            {levels.map((l) => <button type="button" aria-pressed="false" data-value={l.id}>{l.label}</button>)}
          </div>
        </div>
        <button type="button" class="btn ghost small vt__fav" aria-pressed="false" data-favonly>★ Favoris uniquement</button>
      </div>
      <p class="mono vt__count" data-count aria-live="polite"></p>

      {units.map((u) => (
        <section class="unit" data-unit={u} aria-labelledby={`u-${u}`}>
          <h2 class="unit__h" id={`u-${u}`}><Glyph kind={u === 'Chimie' ? 'flask' : u} size={32} /> <span>{u}</span></h2>
          <ul class="grid">
            {videos.filter((v) => v.unit === u).map((v) => (
              <li class="card" data-id={v.id} data-level={v.level} data-text={`${v.title} ${v.titleAr ?? ''} ${v.unit} ${v.summary} ${v.points.join(' ')}`.toLowerCase()}>
                <button type="button" class="card__play" data-play={v.id}>
                  <span class={`thumb ${v.kind === 'official' ? 'thumb--official' : v.unit === 'Chimie' ? 'thumb--chem' : ''}`} aria-hidden="true">
                    {v.kind === 'official'
                      ? <img src={`https://i.ytimg.com/vi/${v.youtubeId}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />
                      : <><span class="thumb__lvl mono">{levelLabel(v.level)} · {v.unit}</span><span class="thumb__t">{v.title}</span><Glyph kind={v.unit === 'Chimie' ? 'flask' : v.unit} size={40} class="thumb__g" /></>}
                    <span class="thumb__bar"><i data-bar={v.id}></i></span>
                  </span>
                  <span class="card__meta mono">{v.kind === 'official' ? 'Officielle · YouTube' : 'Emplacement · fiche démo'}{v.duration ? ` · ${v.duration}` : ''}</span>
                  <span class="card__title">{v.title}</span>
                </button>
                <button type="button" class="card__fav" aria-pressed="false" data-fav={v.id} aria-label={`Ajouter aux favoris : ${v.title}`}>★</button>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="empty" data-empty hidden>
        <p class="display">Aucune leçon trouvée.</p>
        <button type="button" class="btn small" data-clear>Réinitialiser</button>
      </div>

      <div class="hist">
        <div class="hist__head">
          <h2 class="vt__h">Historique (démo, sur cet appareil)</h2>
          <button type="button" class="btn ghost small" data-clear-history>Effacer l’historique</button>
        </div>
        <ol class="hist__list" data-history></ol>
      </div>
    </div>
  </section>
</Base>

<style>
  .vt__stage { border: 1px solid var(--line-strong); background: var(--ink-2); }
  .stage-noscript { padding: 2rem; }
  :global(.st) { display: grid; }
  @media (min-width: 1000px) { :global(.st) { grid-template-columns: 1.5fr 1fr; } }
  :global(.st__media) { position: relative; background: #000; min-height: 0; }
  :global(.st__sheet) { aspect-ratio: 16 / 9; background: radial-gradient(90% 120% at 0% 100%, #7d2235, var(--bordeaux-2) 60%, #2a0a11); display: grid; align-content: space-between; padding: clamp(1rem, 3vw, 2rem); color: var(--chalk); position: relative; overflow: hidden; }
  :global(.st__sheet .glyph) { position: absolute; right: -2%; bottom: -8%; width: 52%; height: auto; opacity: 0.22; color: var(--chalk); }
  :global(.st__slot) { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(14, 11, 10, 0.6); padding: 0.35rem 0.55rem; justify-self: start; }
  :global(.st__step) { font-size: clamp(1.1rem, 2.6vw, 1.9rem); font-weight: 700; line-height: 1.3; max-width: 34ch; position: relative; }
  :global(.st__stepn) { font-family: var(--f-mono); color: var(--signal); font-size: 0.8rem; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; }
  :global(.st__info) { padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: 0.9rem; align-content: start; }
  :global(.st__meta) { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--signal); margin: 0; }
  :global(.st__title) { font-family: var(--f-display); font-stretch: 78%; font-weight: 820; text-transform: uppercase; font-size: clamp(1.5rem, 3vw, 2.3rem); line-height: 1.02; margin: 0; }
  :global(.st__ar) { color: var(--gold); margin: 0; }
  :global(.st__sum) { color: var(--chalk-dim); margin: 0; }
  :global(.st__prog) { height: 6px; background: var(--ink-3); position: relative; }
  :global(.st__prog i) { position: absolute; inset: 0 auto 0 0; background: var(--signal); transition: width 0.4s var(--ease); }
  :global(.st__btns) { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  :global(.st__points) { margin: 0; padding-inline-start: 1.2rem; color: var(--chalk-dim); font-size: 0.95rem; }
  :global(.st__points li.seen) { color: var(--chalk); }

  .vt__rel { margin-top: 1.25rem; }
  :global(.rel) { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  :global(.rel button) { background: none; border: 1px solid var(--line-strong); color: var(--chalk); padding: 0.55rem 0.8rem; min-height: 44px; text-align: start; }
  :global(.rel .mono) { font-size: 0.72rem; }
  :global(.rel button:hover) { border-color: var(--signal); color: var(--signal); }
  .vt__h { font-size: var(--fs-h3); font-stretch: 80%; text-transform: uppercase; }
  .vt__resume { margin-top: 3rem; }
  :global(.resume) { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.6rem; }
  @media (min-width: 760px) { :global(.resume) { grid-template-columns: repeat(3, 1fr); } }
  :global(.resume button) { width: 100%; text-align: start; background: var(--ink-2); border: 1px solid var(--line); color: var(--chalk); padding: 0.9rem; display: grid; gap: 0.5rem; min-height: 44px; }
  :global(.resume button:hover) { border-color: var(--signal); }
  :global(.resume .bar) { height: 4px; background: var(--ink-3); position: relative; }
  :global(.resume .bar i) { position: absolute; inset: 0 auto 0 0; background: var(--signal); }

  .vt__tools { display: grid; gap: 1rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--line-strong); }
  @media (min-width: 1000px) { .vt__tools { grid-template-columns: 1fr auto auto; align-items: end; } }
  .filters__row { display: grid; gap: 0.4rem; }
  .vt__fav { justify-self: start; }
  .vt__count { font-size: 0.78rem; color: var(--chalk-dim); margin: 1rem 0 0; }
  .unit { margin-top: 2.5rem; }
  .unit[hidden] { display: none; }
  .unit__h { display: flex; gap: 0.7rem; align-items: center; font-size: var(--fs-h3); font-stretch: 78%; text-transform: uppercase; padding-bottom: 0.8rem; border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
  .unit__h :global(.glyph) { color: var(--signal); }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .card { position: relative; }
  .card[hidden] { display: none; }
  .card__play { all: unset; cursor: pointer; display: grid; gap: 0.45rem; width: 100%; }
  .card__play:focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }
  .thumb { position: relative; aspect-ratio: 16 / 9; display: grid; place-items: center; background: linear-gradient(135deg, var(--ink-3), var(--bordeaux-2)); color: var(--chalk); overflow: hidden; border: 1px solid var(--line); transition: border-color 0.2s; }
  .card__play:hover .thumb { border-color: var(--signal); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb--official::after { content: '▶'; position: absolute; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--signal); color: var(--ink); font-size: 1rem; }
  .thumb:not(.thumb--official) { place-items: end start; padding: 0.8rem; background: linear-gradient(150deg, var(--bordeaux) 0%, var(--bordeaux-2) 55%, #24090f 100%); }
  .thumb--chem:not(.thumb--official) { background: linear-gradient(150deg, #2a211b 0%, #1a1411 60%, #120e0c 100%); }
  .thumb__t { font-family: var(--f-display); font-stretch: 68%; font-weight: 850; text-transform: uppercase; font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 0.95; max-width: 85%; position: relative; z-index: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .thumb :global(.thumb__g) { position: absolute; right: 0.7rem; top: 0.7rem; color: var(--signal); opacity: 0.9; }
  .thumb__lvl { position: absolute; left: 0.8rem; top: 0.75rem; font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(237,230,218,.75); }
  .thumb__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(0, 0, 0, 0.5); }
  .thumb__bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--signal); }
  .card__meta { font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--chalk-dim); }
  .card__title { font-weight: 700; line-height: 1.3; padding-inline-end: 2.5rem; }
  .card__fav { position: absolute; right: 0; bottom: 0; width: 44px; height: 44px; background: none; border: 1px solid var(--line); color: var(--chalk-dim); font-size: 1.1rem; }
  .card__fav[aria-pressed='true'] { color: var(--ink); background: var(--signal); border-color: var(--signal); }
  .card.is-current .thumb { outline: 3px solid var(--signal); outline-offset: 2px; }
  .empty { padding: 2rem 0; }
  .empty .display { font-size: var(--fs-h2); margin-bottom: 1rem; }
  .hist { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line-strong); }
  .hist__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
  :global(.hist__list) { list-style: none; padding: 0; margin: 1rem 0 0; }
  :global(.hist__list li) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); color: var(--chalk-dim); font-size: 0.95rem; }
  :global(.hist__list .mono) { font-size: 0.75rem; white-space: nowrap; }
</style>

<script>
  import { read, write, toggleIn, pushHistory, announce } from '../../lib/store';
  import { initFacades } from '../../scripts/youtube';

  type V = { id: string; kind: 'official' | 'slot'; youtubeId?: string; title: string; titleAr?: string; level: string; levelLabel: string; chapter?: string; unit: string; duration?: string; summary: string; points: string[] };
  const data: V[] = JSON.parse(document.getElementById('vt-data')!.textContent || '[]');
  const byId = new Map(data.map((v) => [v.id, v]));
  const root = document.querySelector<HTMLElement>('[data-vt]')!;
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const glyphFor = (unit: string) => (root.querySelector(`[data-unit="${CSS.escape(unit)}"] .unit__h svg`) as SVGElement | null)?.outerHTML ?? '';
  let current = '';
  let step = 0;

  function select(id: string, opts: { scroll?: boolean; record?: boolean } = {}) {
    const v = byId.get(id) ?? data[0];
    current = v.id;
    const prog = read('progress');
    if (v.kind === 'slot') {
      const pct = prog[v.id] ?? 0;
      step = Math.min(v.points.length - 1, Math.max(0, Math.round((pct / 100) * v.points.length) - 1));
    }
    render(v);
    if (opts.record !== false) {
      pushHistory(v.id);
      const url = new URL(location.href);
      url.searchParams.set('v', v.id);
      history.replaceState(null, '', url);
    }
    root.querySelectorAll('.card').forEach((c) => c.classList.toggle('is-current', (c as HTMLElement).dataset.id === v.id));
    paintAll();
    if (opts.scroll) stage.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }

  function render(v: V) {
    const bm = read('bookmarks').includes(v.id);
    const pct = read('progress')[v.id] ?? 0;
    const media =
      v.kind === 'official'
        ? `<div class="yt" data-yt="${esc(v.youtubeId!)}" data-yt-title="${esc(v.titleAr ?? v.title)}"><button type="button" class="yt__btn"><span class="sr-only">Lire la vidéo : ${esc(v.title)} (charge le lecteur YouTube) — </span><img src="https://i.ytimg.com/vi/${esc(v.youtubeId!)}/hqdefault.jpg" alt="" width="480" height="360"><span class="yt__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span><span class="yt__label mono">Vidéo officielle · YouTube @ProfHarti</span></button></div>`
        : `<div class="st__sheet">${glyphFor(v.unit)}<span class="st__slot mono">Emplacement vidéo · à connecter à une leçon officielle</span><p class="st__step"><span class="st__stepn">Point ${step + 1} / ${v.points.length}</span>${esc(v.points[step])}</p></div>`;
    stage.innerHTML = `<div class="st">
      <div class="st__media">${media}</div>
      <div class="st__info">
        <p class="st__meta mono">${esc(v.levelLabel)} · ${esc(v.unit)}${v.duration ? ' · ' + esc(v.duration) : ''}</p>
        <h2 class="st__title" tabindex="-1" data-st-title>${esc(v.title)}</h2>
        ${v.titleAr ? `<p class="st__ar ar" lang="ar" dir="rtl">${esc(v.titleAr)}</p>` : ''}
        <p class="st__sum">${esc(v.summary)}</p>
        ${v.kind === 'slot' ? `<ol class="st__points">${v.points.map((p, i) => `<li class="${i <= step && pct > 0 ? 'seen' : ''}">${esc(p)}</li>`).join('')}</ol>` : ''}
        <div class="st__prog" role="progressbar" aria-label="Progression de la leçon" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${pct}"><i style="width:${pct}%"></i></div>
        <div class="st__btns">
          ${v.kind === 'slot' ? `<button type="button" class="btn small" data-next>${step + 1 < v.points.length || pct < 100 ? 'Point suivant →' : 'Revoir depuis le début'}</button>` : ''}
          <button type="button" class="btn ghost small" aria-pressed="${bm}" data-stage-fav>${bm ? '★ Dans mes favoris' : '☆ Ajouter aux favoris'}</button>
        </div>
      </div>
    </div>`;
    initFacades(stage);
    stage.querySelector('[data-yt]')?.addEventListener('yt:loaded', () => { const p = read('progress'); p[v.id] = 100; write('progress', p); paintAll(); });
    // Related lessons: same unit, or same level
    const rel = data.filter((x) => x.id !== v.id && (x.unit === v.unit || (v.level !== 'all' && x.level === v.level))).slice(0, 4);
    const relWrap = root.querySelector<HTMLElement>('[data-related-wrap]')!;
    relWrap.hidden = rel.length === 0;
    root.querySelector('[data-related]')!.innerHTML = rel.map((r) => `<li><button type="button" data-play="${r.id}">${esc(r.title)} <span class="muted mono">· ${esc(r.levelLabel)}</span></button></li>`).join('');
  }

  stage.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const v = byId.get(current)!;
    if (t.closest('[data-next]')) {
      const p = read('progress');
      const pct = p[v.id] ?? 0;
      if (pct >= 100 && step >= v.points.length - 1) { step = 0; p[v.id] = Math.round(100 / v.points.length); }
      else {
        if (pct > 0) step = Math.min(step + 1, v.points.length - 1);
        p[v.id] = Math.round(((step + 1) / v.points.length) * 100);
      }
      write('progress', p);
      render(v);
      paintAll();
      announce(`Point ${step + 1} sur ${v.points.length}. Progression ${p[v.id]} %.`);
      stage.querySelector<HTMLElement>('[data-next]')?.focus();
    }
    if (t.closest('[data-stage-fav]')) {
      const on = toggleIn('bookmarks', v.id);
      render(v); paintAll();
      announce(on ? 'Ajouté aux favoris.' : 'Retiré des favoris.');
      stage.querySelector<HTMLElement>('[data-stage-fav]')?.focus();
    }
  });

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const play = t.closest<HTMLElement>('[data-play]');
    if (play && !stage.contains(play)) { select(play.dataset.play!, { scroll: true }); stage.querySelector<HTMLElement>('[data-st-title]')?.focus({ preventScroll: true }); return; }
    const fav = t.closest<HTMLElement>('[data-fav]');
    if (fav) { const on = toggleIn('bookmarks', fav.dataset.fav!); paintAll(); if (current === fav.dataset.fav) render(byId.get(current)!); announce(on ? 'Ajouté aux favoris.' : 'Retiré des favoris.'); }
  });

  // Filters
  const q = root.querySelector<HTMLInputElement>('[data-q]')!;
  const lvGroup = root.querySelector<HTMLElement>('[data-lv]')!;
  const favOnly = root.querySelector<HTMLButtonElement>('[data-favonly]')!;
  const f = { lv: 'all', q: '', fav: false };
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  function filter() {
    const bms = new Set(read('bookmarks'));
    const nq = norm(f.q.trim());
    let n = 0;
    root.querySelectorAll<HTMLElement>('.card').forEach((c) => {
      const ok = (f.lv === 'all' || c.dataset.level === f.lv || c.dataset.level === 'all') && (!nq || norm(c.dataset.text || '').includes(nq)) && (!f.fav || bms.has(c.dataset.id!));
      c.hidden = !ok; if (ok) n++;
    });
    root.querySelectorAll<HTMLElement>('.unit').forEach((u) => (u.hidden = !u.querySelector('.card:not([hidden])')));
    root.querySelector('[data-count]')!.textContent = `${n} leçon${n > 1 ? 's' : ''}`;
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
  }
  q.addEventListener('input', () => { f.q = q.value; filter(); });
  lvGroup.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (!b) return; f.lv = b.dataset.value!; lvGroup.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); filter(); });
  favOnly.addEventListener('click', () => { f.fav = !f.fav; favOnly.setAttribute('aria-pressed', String(f.fav)); filter(); });
  root.querySelector('[data-clear]')!.addEventListener('click', () => { f.lv = 'all'; f.q = ''; f.fav = false; q.value = ''; favOnly.setAttribute('aria-pressed', 'false'); lvGroup.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.value === 'all'))); filter(); });
  root.querySelector('[data-clear-history]')!.addEventListener('click', () => { write('history', []); paintAll(); announce('Historique effacé.'); });

  function paintAll() {
    const bms = new Set(read('bookmarks'));
    const prog = read('progress');
    root.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => { const on = bms.has(b.dataset.fav!); b.setAttribute('aria-pressed', String(on)); });
    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((i) => (i.style.width = `${prog[i.dataset.bar!] ?? 0}%`));
    const hist = read('history').filter((h) => byId.has(h.id));
    const hl = root.querySelector<HTMLElement>('[data-history]')!;
    hl.innerHTML = hist.length
      ? hist.slice(0, 8).map((h) => `<li><span>${esc(byId.get(h.id)!.title)}</span><span class="mono">${new Date(h.at).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}</span></li>`).join('')
      : '<li>Aucune leçon consultée pour le moment.</li>';
    const resume = hist.map((h) => byId.get(h.id)!).filter((v) => v.kind === 'slot' && (prog[v.id] ?? 0) > 0 && (prog[v.id] ?? 0) < 100).slice(0, 3);
    root.querySelector<HTMLElement>('[data-resume-wrap]')!.hidden = resume.length === 0;
    root.querySelector('[data-resume]')!.innerHTML = resume.map((v) => `<li><button type="button" data-play="${v.id}"><span>${esc(v.title)}</span><span class="bar"><i style="width:${prog[v.id]}%"></i></span><span class="mono muted">${prog[v.id]} % · ${esc(v.levelLabel)}</span></button></li>`).join('');
    if (f.fav) filter();
  }

  const initial = new URLSearchParams(location.search).get('v');
  select(initial && byId.has(initial) ? initial : data[0].id, { record: !!initial });
  filter();
</script>

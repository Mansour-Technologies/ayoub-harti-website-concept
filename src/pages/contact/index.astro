---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { officialLinks } from '../../data/site';
import { levels } from '../../data/courses';
---
<Base title="Contact" description="Contacter Prof Harti via ses canaux officiels. Formulaire de démonstration : aucun message n’est envoyé." current="contact/">
  <PageHero num="07" kicker="Contact" title="Une question ? <em>Écris-lui.</em>" ar="تواصل مع الأستاذ" glyph="wave">
    <p>Pour toute question ou inscription au programme <span class="ar" lang="ar" dir="rtl">عرض التفوق</span>, le professeur communique via ses canaux officiels ci-dessous. Ce site n’est pas un canal officiel.</p>
  </PageHero>

  <section class="section">
    <div class="wrap contact">
      <div>
        <h2 class="kicker">Canaux officiels vérifiés</h2>
        <ul class="off">
          {Object.values(officialLinks).map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener noreferrer"><span class="display off__name">{l.label}</span><span class="mono off__h">{l.handle}</span><span aria-hidden="true" class="off__go">↗</span><span class="sr-only"> (nouvel onglet)</span></a></li>
          ))}
        </ul>
        <p class="muted small">Les coordonnées directes publiées par le professeur ne sont volontairement pas reproduites sur ce concept non officiel.</p>
      </div>

      <form class="demo-form" data-demo-form novalidate>
        <div class="demo-form__head">
          <h2 class="kicker">Formulaire — démonstration</h2>
          <span class="demo-badge">N’envoie rien</span>
        </div>
        <p class="muted small">Aperçu du futur formulaire. Aucune donnée n’est transmise ni enregistrée ; aucune information personnelle n’est demandée.</p>
        <div class="field">
          <label for="f-level">Niveau</label>
          <select id="f-level" class="input" required>
            <option value="">Choisir…</option>
            {levels.map((l) => <option value={l.id}>{l.long}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-topic">Sujet</label>
          <select id="f-topic" class="input" required>
            <option value="">Choisir…</option>
            <option>Question sur un chapitre</option>
            <option>Programme عرض التفوق</option>
            <option>Autre</option>
          </select>
        </div>
        <div class="field">
          <label for="f-msg">Message</label>
          <textarea id="f-msg" class="input" rows="5" required minlength="10" placeholder="Ta question en quelques lignes…"></textarea>
        </div>
        <p class="form-err" data-err role="alert"></p>
        <button type="submit" class="btn">Tester l’envoi <span class="arr" aria-hidden="true">→</span></button>
        <div class="form-ok" data-ok hidden tabindex="-1">
          <p><strong>Démonstration : rien n’a été envoyé.</strong></p>
          <p>Sur le site final, ce message pourrait être transmis au professeur. En attendant, écris-lui via <a href={officialLinks.instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a>.</p>
        </div>
      </form>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .contact { grid-template-columns: 1fr 1fr; gap: 5rem; } }
  .off { list-style: none; padding: 0; margin: 1rem 0 1.5rem; border-top: 1px solid var(--line-strong); }
  .off a { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'n go' 'h go'; padding: 1.1rem 0; border-bottom: 1px solid var(--line-strong); text-decoration: none; }
  .off__name { grid-area: n; font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .off__h { grid-area: h; color: var(--signal); font-size: 0.85rem; }
  .off__go { grid-area: go; align-self: center; font-size: 1.8rem; color: var(--chalk-dim); }
  .off a:hover .off__name { color: var(--signal); }
  .small { font-size: var(--fs-small); }
  .demo-form { display: grid; gap: 1.1rem; padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--line-strong); background: var(--ink-2); align-content: start; }
  .demo-form__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .demo-form .btn { justify-self: start; }
  textarea.input { resize: vertical; }
  select.input { appearance: auto; }
  .form-err { color: var(--bad); margin: 0; min-height: 1.2em; font-weight: 600; }
  .form-ok { border-inline-start: 3px solid var(--ok); padding: 0.8rem 1rem; background: rgba(124, 207, 138, 0.08); outline: none; }
  .form-ok p { margin: 0 0 0.4rem; }
</style>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-demo-form]')!;
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const err = f.querySelector<HTMLElement>('[data-err]')!;
    const bad = Array.from(f.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]')).find((el) => !el.checkValidity());
    f.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    if (bad) { bad.setAttribute('aria-invalid', 'true'); err.textContent = `Champ à compléter : ${f.querySelector(`label[for="${bad.id}"]`)?.textContent ?? ''}${bad.id === 'f-msg' ? ' (10 caractères minimum)' : ''}.`; bad.focus(); return; }
    err.textContent = '';
    const ok = f.querySelector<HTMLElement>('[data-ok]')!;
    ok.hidden = false; ok.focus();
    f.reset();
  });
</script>

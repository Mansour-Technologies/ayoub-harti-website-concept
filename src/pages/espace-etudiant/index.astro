---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { levels, chapters } from '../../data/courses';
import { videos } from '../../data/videos';
import { checklists, themes } from '../../data/quiz';
import { withBase } from '../../lib/url';

const payload = {
  levels: levels.map((l) => ({ id: l.id, label: l.label, total: chapters.filter((c) => c.level === l.id).length })),
  chapters: chapters.map((c) => ({ id: c.id, title: c.title, level: c.level })),
  videos: videos.map((v) => ({ id: v.id, title: v.title, kind: v.kind, chapter: v.chapter ?? null, level: v.level })),
  checklists: checklists.map((c) => ({ theme: c.theme, label: themes.find((t) => t.id === c.theme)!.label, n: c.items.length })),
  base: withBase(''),
};
const goals = [
  { id: 'g1', label: 'Terminer 2 fiches de la vidéothèque' },
  { id: 'g2', label: 'Faire une série de quiz « difficile »' },
  { id: 'g3', label: 'Cocher 5 compétences dans les check-lists' },
  { id: 'g4', label: 'Tester 30° et 60° dans le laboratoire' },
];
---
<Base title="Espace étudiant — Démonstration" description="Démonstration d’un espace élève : progression des cours, favoris vidéo, révisions, résultats de quiz et objectifs de la semaine, stockés uniquement sur cet appareil." current="espace-etudiant/">
  <PageHero num="06" kicker="Espace étudiant · Démonstration" title="Ma <em>progression.</em>" ar="فين وصلت؟" glyph="field">
    <p>Tableau de bord de démonstration : aucune inscription, aucun compte, aucune donnée personnelle. Tout est calculé à partir de ce que tu fais sur ce site et reste dans le stockage local de ton navigateur.</p>
  </PageHero>

  <section class="section dash" data-dash>
    <script type="application/json" id="dash-data" set:html={JSON.stringify(payload)} />
    <div class="wrap">
      <div class="next" data-next-wrap>
        <div>
          <p class="kicker">Leçon recommandée</p>
          <p class="next__title display" data-next-title>—</p>
          <p class="muted" data-next-why></p>
        </div>
        <a class="btn" href={withBase('videotheque/')} data-next-link>Continuer <span class="arr" aria-hidden="true">→</span></a>
      </div>

      <dl class="kpi">
        <div><dt>Chapitres étudiés</dt><dd data-k-courses>0</dd></div>
        <div><dt>Leçons commencées</dt><dd data-k-lessons>0</dd></div>
        <div><dt>Score moyen aux quiz</dt><dd data-k-quiz>—</dd></div>
        <div><dt>Check-lists</dt><dd data-k-cl>0 %</dd></div>
      </dl>

      <div class="dgrid">
        <section class="panel" aria-labelledby="p-courses">
          <h2 id="p-courses" class="panel__h">Cours par niveau</h2>
          <ul class="bars" data-courses></ul>
          <a class="link-arrow" href={withBase('cours/')}>Aller aux cours →</a>
        </section>

        <section class="panel" aria-labelledby="p-rev">
          <h2 id="p-rev" class="panel__h">Révisions (check-lists)</h2>
          <ul class="bars" data-rev></ul>
          <a class="link-arrow" href={withBase('examens/')}>Réviser →</a>
        </section>

        <section class="panel" aria-labelledby="p-quiz">
          <h2 id="p-quiz" class="panel__h">Résultats de quiz</h2>
          <div class="qchart" data-qchart aria-hidden="true"></div>
          <ol class="list" data-quiz></ol>
        </section>

        <section class="panel" aria-labelledby="p-bm">
          <h2 id="p-bm" class="panel__h">Mes favoris vidéo</h2>
          <ul class="list" data-bookmarks></ul>
          <a class="link-arrow" href={withBase('videotheque/')}>Vidéothèque →</a>
        </section>

        <section class="panel" aria-labelledby="p-goals">
          <h2 id="p-goals" class="panel__h">Objectifs de la semaine</h2>
          <ul class="goals" data-goals>
            {goals.map((g) => <li><label><input type="checkbox" data-goal={g.id} /> <span>{g.label}</span></label></li>)}
          </ul>
          <p class="mono muted small" data-goals-count></p>
        </section>

        <section class="panel" aria-labelledby="p-up">
          <h2 id="p-up" class="panel__h">À venir <span class="demo-badge">Illustratif</span></h2>
          <ul class="list up">
            <li><span>Série mixte « Électricité »</span><span class="mono">à planifier</span></li>
            <li><span>Fiche « Diagramme de prédominance »</span><span class="mono">suggestion</span></li>
            <li><span>Annonces du programme</span><span class="mono">canaux officiels</span></li>
          </ul>
          <p class="muted small">Exemples d’activités pour montrer l’agenda : aucune date ni séance réelle n’est annoncée.</p>
        </section>
      </div>

      <div class="reset">
        <div>
          <p class="kicker">Données de démonstration</p>
          <p class="muted small">Stockées uniquement dans ce navigateur (localStorage). Tu peux tout effacer à tout moment.</p>
        </div>
        <div class="reset__btns">
          <button type="button" class="btn ghost" data-reset-ask>Réinitialiser la démo</button>
          <span data-reset-confirm hidden>
            <button type="button" class="btn small" data-reset-yes>Oui, tout effacer</button>
            <button type="button" class="btn ghost small" data-reset-no>Annuler</button>
          </span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .next { display: grid; gap: 1.5rem; align-items: end; padding: clamp(1.5rem, 4vw, 2.5rem); background: var(--signal); color: var(--ink); margin-bottom: 2rem; }
  @media (min-width: 860px) { .next { grid-template-columns: 1fr auto; } }
  .next .kicker, .next .muted { color: #3b2f12; }
  .next__title { font-size: clamp(1.8rem, 4.2vw, 3.2rem); margin: 0.4rem 0 0.5rem; }
  .next .btn { --b: var(--ink); color: var(--signal); }
  .kpi { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin: 0 0 2.5rem; border-top: 1px solid var(--line-strong); border-inline-start: 1px solid var(--line-strong); }
  @media (min-width: 860px) { .kpi { grid-template-columns: repeat(4, 1fr); } }
  .kpi div { padding: 1.1rem 1rem; border-bottom: 1px solid var(--line-strong); border-inline-end: 1px solid var(--line-strong); }
  .kpi dt { font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--chalk-dim); }
  .kpi dd { margin: 0.3rem 0 0; font-family: var(--f-display); font-stretch: 70%; font-weight: 850; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1; }
  .dgrid { display: grid; gap: 2.5rem 3rem; }
  @media (min-width: 900px) { .dgrid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1240px) { .dgrid { grid-template-columns: 1fr 1fr 1fr; } }
  .panel { border-top: 2px solid var(--chalk); padding-top: 1rem; display: grid; gap: 1rem; align-content: start; }
  .panel__h { font-size: 1.3rem; font-stretch: 78%; text-transform: uppercase; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  :global(.bars) { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  :global(.bars li) { display: grid; gap: 0.3rem; }
  :global(.bars .row) { display: flex; justify-content: space-between; font-size: 0.92rem; }
  :global(.bars .row .mono) { color: var(--chalk-dim); font-size: 0.8rem; }
  :global(.bars .bar) { height: 6px; background: var(--ink-3); position: relative; }
  :global(.bars .bar i) { position: absolute; inset: 0 auto 0 0; background: var(--signal); }
  :global(.list) { list-style: none; padding: 0; margin: 0; }
  :global(.list li) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  :global(.list li .mono) { color: var(--chalk-dim); font-size: 0.78rem; white-space: nowrap; }
  :global(.list a) { text-decoration: none; }
  :global(.list a:hover) { color: var(--signal); }
  .qchart { display: flex; align-items: flex-end; gap: 6px; height: 80px; border-bottom: 1px solid var(--line-strong); }
  :global(.qchart span) { flex: 1; max-width: 28px; background: var(--signal); min-height: 3px; }
  .goals { list-style: none; padding: 0; margin: 0; }
  .goals label { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.6rem 0; border-bottom: 1px solid var(--line); cursor: pointer; min-height: 44px; }
  .goals input { accent-color: var(--signal); width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; flex: none; }
  .goals label:has(input:checked) span { color: var(--chalk-dim); text-decoration: line-through; }
  .small { font-size: var(--fs-small); margin: 0; }
  .up li span:first-child { color: var(--chalk); }
  .reset { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-strong); }
  .reset__btns, [data-reset-confirm] { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  [data-reset-confirm][hidden] { display: none; }
</style>

<script>
  import { read, write, resetAll, announce } from '../../lib/store';
  const D = JSON.parse(document.getElementById('dash-data')!.textContent || '{}') as {
    levels: { id: string; label: string; total: number }[];
    chapters: { id: string; title: string; level: string }[];
    videos: { id: string; title: string; kind: string; chapter: string | null; level: string }[];
    checklists: { theme: string; label: string; n: number }[];
    base: string;
  };
  const root = document.querySelector<HTMLElement>('[data-dash]')!;
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const vById = new Map(D.videos.map((v) => [v.id, v]));
  const chIds = new Set(D.chapters.map((c) => c.id));

  function paint() {
    const studied = read('courses').filter((id) => chIds.has(id));
    const prog = read('progress');
    const quiz = read('quiz');
    const cl = read('checklist');
    const bms = read('bookmarks').filter((id) => vById.has(id));
    const goals = read('goals');
    const history = read('history').filter((h) => vById.has(h.id));

    $('[data-k-courses]').textContent = `${studied.length}/${D.chapters.length}`;
    const started = Object.entries(prog).filter(([id, p]) => vById.has(id) && p > 0);
    $('[data-k-lessons]').textContent = String(started.length);
    $('[data-k-quiz]').textContent = quiz.length ? `${Math.round((quiz.reduce((a, r) => a + r.score / r.total, 0) / quiz.length) * 100)} %` : '—';
    const clTotal = D.checklists.reduce((a, c) => a + c.n, 0);
    const clDone = D.checklists.reduce((a, c) => a + Array.from({ length: c.n }, (_, i) => cl[`${c.theme}:${i}`]).filter(Boolean).length, 0);
    $('[data-k-cl]').textContent = `${Math.round((clDone / clTotal) * 100)} %`;

    $('[data-courses]').innerHTML = D.levels.map((l) => {
      const n = studied.filter((id) => D.chapters.find((c) => c.id === id)?.level === l.id).length;
      return `<li><span class="row"><span>${esc(l.label)}</span><span class="mono">${n}/${l.total}</span></span><span class="bar"><i style="width:${(n / l.total) * 100}%"></i></span></li>`;
    }).join('');
    $('[data-rev]').innerHTML = D.checklists.map((c) => {
      const n = Array.from({ length: c.n }, (_, i) => cl[`${c.theme}:${i}`]).filter(Boolean).length;
      return `<li><span class="row"><span>${esc(c.label)}</span><span class="mono">${n}/${c.n}</span></span><span class="bar"><i style="width:${(n / c.n) * 100}%"></i></span></li>`;
    }).join('');

    const lastQ = quiz.slice(-10);
    $('[data-qchart]').innerHTML = lastQ.map((r) => `<span style="height:${Math.max(4, (r.score / r.total) * 100)}%"></span>`).join('');
    $('[data-quiz]').innerHTML = lastQ.length
      ? lastQ.slice().reverse().slice(0, 5).map((r) => `<li><span>${r.theme === 'mix' ? 'Série mixte' : esc(D.checklists.find((c) => c.theme === r.theme)?.label ?? r.theme)} · ${new Date(r.at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' })}</span><span class="mono">${r.score}/${r.total}</span></li>`).join('')
      : `<li><span>Aucun quiz terminé.</span><a class="mono" href="${D.base}examens/">Commencer →</a></li>`;
    $('[data-bookmarks]').innerHTML = bms.length
      ? bms.map((id) => `<li><a href="${D.base}videotheque/?v=${encodeURIComponent(id)}">${esc(vById.get(id)!.title)}</a><span class="mono">${prog[id] ?? 0} %</span></li>`).join('')
      : '<li><span>Aucun favori. Utilise ★ dans la vidéothèque.</span></li>';

    root.querySelectorAll<HTMLInputElement>('[data-goal]').forEach((i) => (i.checked = !!goals[i.dataset.goal!]));
    const gDone = Object.values(goals).filter(Boolean).length;
    $('[data-goals-count]').textContent = `${Math.min(gDone, 4)}/4 objectifs atteints`;

    // Recommendation: resume an unfinished lesson, else the first unstudied 2 Bac chapter with a lesson slot.
    const resume = history.map((h) => vById.get(h.id)!).find((v) => v.kind === 'slot' && (prog[v.id] ?? 0) > 0 && (prog[v.id] ?? 0) < 100);
    let rec = resume, why = resume ? `Reprendre : ${prog[resume.id]} % parcourus.` : '';
    if (!rec) {
      rec = D.videos.find((v) => v.kind === 'slot' && v.level === '2bac' && v.chapter && !studied.includes(v.chapter) && (prog[v.id] ?? 0) < 100) ?? D.videos.find((v) => v.kind === 'slot');
      why = 'Prochain chapitre de 2ème Bac non encore étudié.';
    }
    if (rec) {
      $('[data-next-title]').textContent = rec.title;
      $('[data-next-why]').textContent = why;
      ($('[data-next-link]') as HTMLAnchorElement).href = `${D.base}videotheque/?v=${encodeURIComponent(rec.id)}`;
    }
  }

  root.addEventListener('change', (e) => {
    const i = e.target as HTMLInputElement;
    if (!i.dataset.goal) return;
    const g = read('goals'); g[i.dataset.goal] = i.checked; write('goals', g); paint();
  });
  const ask = $('[data-reset-ask]'), conf = $('[data-reset-confirm]');
  ask.addEventListener('click', () => { ask.hidden = true; conf.hidden = false; root.querySelector<HTMLElement>('[data-reset-yes]')!.focus(); });
  $('[data-reset-no]').addEventListener('click', () => { conf.hidden = true; ask.hidden = false; ask.focus(); });
  $('[data-reset-yes]').addEventListener('click', () => { resetAll(); conf.hidden = true; ask.hidden = false; ask.focus(); paint(); announce('Données de démonstration effacées.'); });
  paint();
</script>
